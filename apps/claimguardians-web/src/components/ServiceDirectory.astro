---
import Icon from './DesignIcon.astro';
const services = [
  { title:'Water & leak damage', slug:'water-damage', icon:'water', image:'hero-water-damage.png', text:'Burst pipes, leaks and damage to the spaces you live or work in.', items:['Damage documentation','Policy and estimate review','Communication with the insurer'] },
  { title:'Hurricane & storm', slug:'hurricane-damage', icon:'wind', image:'hero-hurricane-damage.png', text:'Wind, hail and storm losses, with the property and policy in view.', items:['Storm damage records','Scope and inspection questions','New or partially paid claims'] },
  { title:'Roof damage', slug:'roof-damage', icon:'roof', image:'hero-roof-damage.png', text:'Make sense of inspection findings, repair scope and payment decisions.', items:['Damage and repair records','Roof estimate comparison','Denied or underpaid claims'] },
  { title:'Fire & smoke', slug:'fire-damage', icon:'fire', image:'hero-fire-damage.png', text:'Review the impact on the building, belongings and use of the property.', items:['Fire and smoke documentation','Contents and expense records','Review of the insurer’s scope'] },
  { title:'Mold damage', slug:'mold-claims', icon:'mold', image:'hero-mold-damage.png', text:'Understand how moisture, professional findings and policy terms connect.', items:['Moisture and assessment records','The reported source of damage','Coverage questions to discuss'] },
  { title:'Denied & underpaid', slug:'denied-claims', icon:'denied', image:'hero-denied-claims.png', text:'A closer look at the written decision and the evidence behind the claim.', items:['Denial letter review','Compare payments and estimates','Discuss available next steps'] },
];
---
<section class="service-directory design-shell" aria-labelledby="service-directory-heading"><div class="directory-heading"><p class="design-kicker">Find the service that fits</p><h2 id="service-directory-heading">Start with your property.<br /><em>Then choose your next step.</em></h2></div><div class="service-directory-grid">{services.map((service,i) => <article class="service-directory-card"><a href={`/services/${service.slug}/`} class="service-directory-image" tabindex="-1" aria-hidden="true"><img src={`/images/${service.image}`} alt="" width="640" height="640" loading="lazy" /><span>0{i+1} / Property claims</span></a><div class="service-directory-body"><div class="service-directory-title"><Icon name={service.icon} size={25} /><h3><a href={`/services/${service.slug}/`}>{service.title}</a></h3></div><p>{service.text}</p><ul>{service.items.map(item => <li>{item}</li>)}</ul><a class="design-text-link" href={`/services/${service.slug}/`}>Explore {service.title.toLowerCase()} <Icon size={20} /></a></div></article>)}</div></section>
