---
const { city } = Astro.props as { city: string };
const cities = [
  { name: 'Charlotte', slug: 'charlotte' },
  { name: 'Raleigh', slug: 'raleigh' },
  { name: 'Wilmington', slug: 'wilmington' },
  { name: 'Asheville', slug: 'asheville' },
  { name: 'Fayetteville', slug: 'fayetteville' },
  { name: 'Jacksonville', slug: 'jacksonville-nc' },
];
---
<section class="section-white" aria-labelledby="nc-area-links">
  <div class="section-inner">
    <h2 id="nc-area-links" class="section-heading mb-5">Other North Carolina service areas</h2>
    <p class="text-slate-700 mb-6">Looking for help at another property? Choose its city or view our statewide coverage.</p>
    <ul class="flex flex-wrap gap-x-7 gap-y-4 mb-6">
      {cities.filter(item => item.name !== city).map(item => <li><a class="font-bold text-[#006775] underline" href={`/service-areas/north-carolina/${item.slug}/`}>Public adjuster in {item.name}, NC</a></li>)}
    </ul>
    <a class="font-bold text-[#006775] underline" href="/service-areas/north-carolina/">All North Carolina service areas</a>
  </div>
</section>
