---
import type { ReviewProfile } from '../data/market-review';
const { profile } = Astro.props as { profile: ReviewProfile };
---
<section class="section-muted" aria-labelledby="market-review-heading">
  <div class="section-inner">
    <div class="max-w-3xl mb-10">
      <span class="eyebrow">Your claim, your documents</span>
      <h2 id="market-review-heading" class="section-heading mb-5">{profile.heading}</h2>
      <p class="text-lg text-slate-700 leading-relaxed">{profile.intro}</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      {profile.topics.map(topic => <article class="card-hover p-7"><h3 class="text-xl font-bold text-[#082142] mb-3">{topic.title}</h3><p class="text-slate-700 leading-relaxed">{topic.text}</p></article>)}
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-white p-7 rounded-2xl border border-slate-200">
        <h3 class="text-2xl font-bold text-[#082142] mb-5">Documents to keep ready</h3>
        <ul class="list-disc pl-5 space-y-3 text-slate-700">{profile.documents.map(item => <li>{item}</li>)}</ul>
        <p class="text-sm text-slate-600 mt-5">Enter only a short summary in the form. Keep policy numbers, financial records and private documents for the follow-up conversation.</p>
      </div>
      <div class="bg-white p-7 rounded-2xl border border-slate-200">
        <h3 class="text-2xl font-bold text-[#082142] mb-5">Choose the review you need</h3>
        <ul class="space-y-4 mb-6">{profile.services.map(service => <li><a href={service.href} class="font-bold text-[#006775] underline">{service.label}</a></li>)}</ul>
        <a href="#claim-form" class="btn-accent">Request a free claim review</a>
        <p class="text-sm text-slate-600 mt-5">The initial review does not guarantee coverage or a settlement. Confirm the assigned professional’s credentials and proposed terms before engagement.</p>
      </div>
    </div>
    <div class="mt-8 text-sm text-slate-600">
      <p class="font-bold mb-2">Official consumer resources</p>
      {profile.sources.map(source => <a href={source.href} class="block text-[#006775] underline mb-2">{source.label}</a>)}
      <p>Resources checked October 19, 2026. Coverage and deadlines need review for your particular policy and loss.</p>
    </div>
  </div>
</section>
