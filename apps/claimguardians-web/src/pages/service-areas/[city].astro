          <div class="flex items-center gap-3 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> {stateName} Licensed</div>
          <div class="flex items-center gap-3 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> No Recovery, No Fee</div>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Common Property Damage -->
  <section class="section-white">
