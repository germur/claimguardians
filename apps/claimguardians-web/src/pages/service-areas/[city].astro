                <span class="text-slate-500 font-medium text-sm uppercase">Insurance Offer</span>
                <span class="text-red-400 line-through font-bold text-xl">{cs.initialOffer}</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-[#082142] font-bold text-sm uppercase">Our Settlement</span>
                <span class="text-green-600 font-black text-3xl tracking-tighter">{cs.result}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Our Process -->
