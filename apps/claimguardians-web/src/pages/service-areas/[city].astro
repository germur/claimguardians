const { data } = Astro.props;
const { city, county, stateCode, stateName, localRisk, zipCodes, nearbyAreas, damageAngles } = data;
const profile = getMarketReview(city, stateCode);
const faq = profile.faq;
const priority = ["Los Angeles", "Miami", "West Palm Beach"].includes(city);
const searchCopy: Record<string, { title: string; description: string }> = {
  'Los Angeles': { title: 'Los Angeles Public Adjuster | Fire & Smoke Claim Review', description: 'Review a Los Angeles fire or smoke claim. Prepare damage records, compare the insurer’s scope and request a free claim review in English or Spanish.' },
  'Miami': { title: 'Miami Public Adjuster | Water, Roof & Condo Claim Review', description: 'Review a Miami water, roof or condo insurance claim. See which records to prepare and request a free property claim review in English or Spanish.' },
  'West Palm Beach': { title: 'West Palm Beach Public Adjuster | Roof & Storm Claim Review', description: 'Review a West Palm Beach roof or storm insurance claim. Organize inspection records and the insurer’s decision, then request a free claim review.' },
};
const reviewAngles = priority ? { primary: profile.topics[0].title, primaryDesc: profile.topics[0].text, secondary: profile.topics[1].title, secondaryDesc: profile.topics[1].text, tertiary: profile.topics[2].title, tertiaryDesc: profile.topics[2].text } : damageAngles;

---

<BaseLayout
  title={searchCopy[city]?.title || `Public Adjuster in ${city}, ${stateCode} - Property Damage Claims | Claim Guardians`}
  description={searchCopy[city]?.description || `Public adjuster claim review in ${city}, ${stateCode}. Prepare damage records, understand a denial or partial payment, and request a review in English or Spanish.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Service",
      "@id": `https://allclaimguardians.com${Astro.url.pathname}#service`,
      "name": `Public adjusting services in ${city}, ${stateCode}`,
      "provider": { "@id": "https://allclaimguardians.com/#organization" },
      "url": `https://allclaimguardians.com${Astro.url.pathname}`,
      "areaServed": { "@type": "AdministrativeArea", "name": `${county}, ${stateName}` },
      "description": `Property insurance claim review, damage documentation, and negotiation for property owners in ${county}.`
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allclaimguardians.com/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://allclaimguardians.com/service-areas/" },
        { "@type": "ListItem", "position": 3, "name": city, "item": `https://allclaimguardians.com/service-areas/${city.toLowerCase().replace(/\s+/g, '-')}/` }
      ]
    })} />
  </Fragment>

  <!-- 1. Hero -->
  <header class="relative bg-[#041224] overflow-hidden" style="padding-top:8rem; padding-bottom:8rem;">
    <div class="absolute inset-0 z-0">
      <Image src={stateCode === 'CA' ? '/images/hero-fire-damage.png' : '/images/hero-city-florida.png'} width={1920} height={1080} alt="" class="w-full h-full object-cover opacity-60 scale-105" fetchpriority="high" loading="eager"/>
      <div class="absolute inset-0 bg-gradient-to-b from-[#041224]/40 via-[#002D51]/20 to-[#041224]"></div>
    </div>
    <div class="section-inner relative z-10">
      <nav aria-label="Breadcrumb" class="mb-10 inline-flex">
        <ol class="flex items-center space-x-2 text-sm text-slate-400 font-medium bg-white/5 backdrop-blur-md px-4 py-2 rounded-full border border-white/10">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li><a href="/service-areas/" class="hover:text-white transition-colors">Service Areas</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li class="text-white" aria-current="page">{city}</li>
        </ol>
      </nav>
      <div class="max-w-4xl">
        <span class="eyebrow" style="color:#00B5A6;">Public Adjuster - {county}</span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-8 leading-[1.1] tracking-tight">
          {searchCopy[city]?.title.replace(' | ', ' for ') || `Public Adjuster in ${city}, ${stateCode} for Property Damage Claims.`}
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 mb-12 leading-relaxed max-w-3xl">
          {searchCopy[city]?.description || `${city} properties face ${localRisk}. Claim Guardians helps property owners in ${county} document the loss, review their policy, and discuss the insurer’s response. Coverage and any recovery depend on the policy and evidence.`}
        </p>
        <div class="flex flex-col sm:flex-row gap-5 mb-14">
          <a href="#claim-form" class="btn-accent px-10 py-5 text-lg min-h-[60px]">Request a free claim review</a>
          <a href="tel:3058045489" class="inline-flex justify-center items-center px-10 py-5 text-lg font-bold text-white bg-white/5 backdrop-blur-md border-2 border-white/20 rounded-xl hover:bg-white/10 transition-all duration-300 transform hover:-translate-y-1 min-h-[60px]">Discuss your claim</a>
        </div>
        <div class="flex flex-wrap items-center gap-x-10 gap-y-4 pt-6 border-t border-white/10">
          <div class="flex items-center gap-3 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> Serving all of {county}</div>
          <div class="flex items-center gap-3 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> <a href="/company/" class="underline">Check professional credentials</a></div>
          <div class="flex items-center gap-3 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> No Recovery, No Fee</div>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Common Property Damage -->
  {!priority && <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Local Risks</span>
        <h2 class="section-heading">What to examine in your {city} claim</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card-hover p-8">
          <h3 class="text-xl font-bold text-[#082142] mb-3">{reviewAngles.primary}</h3>
          <p class="text-slate-500 leading-relaxed">{reviewAngles.primaryDesc}</p>
        </div>
        <div class="card-hover p-8">
          <h3 class="text-xl font-bold text-[#082142] mb-3">{reviewAngles.secondary}</h3>
          <p class="text-slate-500 leading-relaxed">{reviewAngles.secondaryDesc}</p>
        </div>
        <div class="card-hover p-8">
          <h3 class="text-xl font-bold text-[#082142] mb-3">{reviewAngles.tertiary}</h3>
          <p class="text-slate-500 leading-relaxed">{reviewAngles.tertiaryDesc}</p>
        </div>
      </div>
    </div>
  </section>

  }

  <MarketReview profile={profile} />

  <!-- 4. Our Process -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">How It Works</span>
        <h2 class="section-heading">Our Claims Process in {city}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="step-number mx-auto">1</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Free Inspection</h3>
          <p class="text-slate-500">We discuss the damage and available records, then confirm whether an inspection is appropriate and when it can be scheduled.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">2</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Full Documentation</h3>
          <p class="text-slate-500">We photograph, measure, and estimate every point of damage using thermal imaging, drones, and contractor pricing.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">3</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Claim & Negotiation</h3>
          <p class="text-slate-500">We file your claim with a detailed scope of loss and negotiate directly with your insurer on your behalf.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">4</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Review the Outcome</h3>
          <p class="text-slate-500">We explain the response and any remaining disagreements. Available next steps depend on the policy, evidence and applicable deadlines.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Coverage Zip Codes -->
  <section class="section-muted text-center">
    <div class="section-inner">
      <span class="eyebrow">Coverage Zones</span>
      <h2 class="section-heading mb-4">Serving {city} and {nearbyAreas}</h2>
      <p class="text-lg text-slate-500 mb-12 max-w-2xl mx-auto">
        We discuss properties in the following zip codes and all surrounding neighborhoods across {county}.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        {zipCodes.map((zip) => (
          <div class="px-6 py-3 bg-white border border-slate-200 rounded-full shadow-sm text-lg font-bold text-[#002D51]">{zip}</div>
        ))}
        <div class="px-6 py-3 bg-white border border-slate-200 rounded-full shadow-sm text-lg font-bold text-slate-400">+ All surrounding areas</div>
      </div>
    </div>
  </section>

  <!-- 6. FAQs -->
  <section class="section-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="eyebrow">Common Questions</span>
        <h2 class="section-heading">Frequently Asked Questions - {city} Public Adjuster</h2>
      </div>
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
              <span>{item.q}</span>
              <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
            </summary>
            <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Services Cross-Links -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-12">
        <span class="eyebrow">Our Services</span>
        <h2 class="section-heading">Property Damage Services in {city}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/hurricane-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Hurricane & Storm Damage</h3>
          <p class="text-slate-500">Wind, hail, and structural storm damage claims across {county}.</p>
        </a>
        <a href="/services/water-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Water Damage & Leaks</h3>
          <p class="text-slate-500">Burst pipes, hidden leaks, and flood damage claims in {city}.</p>
        </a>
        <a href="/services/roof-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Roof Damage Claims</h3>
          <p class="text-slate-500">Full roof replacement claims for storm-damaged {city} properties.</p>
        </a>
        <a href="/services/fire-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Fire & Smoke Damage</h3>
          <p class="text-slate-500">Structural fire and smoke contamination claims in {county}.</p>
        </a>
        <a href="/services/mold-claims/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Mold Damage Claims</h3>
          <p class="text-slate-500">Mold remediation coverage claims for {city} homeowners.</p>
        </a>
        <a href="/services/denied-claims/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Denied & Underpaid Claims</h3>
          <p class="text-slate-500">Claim appeal and reversal services in {county}.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- 8. Final CTA -->
  <section class="gradient-accent-bar section-white text-center">
    <div class="section-inner">
      <span class="eyebrow">No-Risk Consultation</span>
      <h2 class="section-heading mb-4">Was Your {city} Property Damaged?</h2>
      <p class="text-xl text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        Don't let the insurance company dictate the outcome of your claim. Request a review of your policy, damage records and insurer’s response.
      </p>
      <a href="#claim-form" class="btn-accent px-12 py-5 text-xl min-h-[64px]">Request Free {city} Case Review</a>
      <p class="text-sm text-slate-400 mt-4">Zero upfront cost. Ever.</p>
    </div>
  </section>

  <section class="section-muted" id="claim-form"><div class="section-inner max-w-3xl"><h2 class="section-heading mb-5">Request your {city} claim review</h2><p class="text-lg text-slate-700 mb-8">Tell us how to reach you and briefly describe the damage. We will discuss your records and next steps in English or Spanish.</p><div class="bg-white border border-slate-200 rounded-2xl p-6 md:p-9"><LeadCaptureForm client:visible leadType="service_review" state={stateCode} /></div></div></section>

  <!-- Mobile Sticky CTA -->
  <div class="fixed bottom-0 left-0 right-0 p-4 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] z-50 sm:hidden">
    <a href="tel:3058045489" class="btn-accent w-full text-lg">Call {city} Expert Now</a>
  </div>


  <section class="section-muted">
    <div class="section-inner max-w-4xl">
      <h2 class="section-heading mb-4">What should you bring to a claim review?</h2>
      <p class="text-lg text-slate-700 leading-relaxed mb-5">Bring your policy, dated photos, repair estimates or reports, and any insurer letters. If the claim was denied or paid, include the decision and a timeline of communication. The review considers your policy and documented damage; it does not guarantee coverage or a particular settlement.</p>
      <div class="flex flex-wrap gap-5"><a class="text-[#006775] font-bold underline" href="/resources/claim-review-guide/">Read the claim review guide</a><a class="text-[#006775] font-bold underline" lang="es" href="/es/guia-reclamacion/">Guía de reclamaciones en español</a></div>
    </div>
  </section>
</BaseLayout>
