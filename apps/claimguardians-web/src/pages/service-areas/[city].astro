const { data } = Astro.props;
const { city, county, stateCode, stateName, localRisk, zipCodes, nearbyAreas, damageAngles, caseStudies, faq } = data;
---

<BaseLayout
  title={`Public Adjuster in ${city}, ${stateCode} - Property Damage Claims | Claim Guardians`}
  description={`Licensed public adjuster in ${city}, ${stateCode}. We handle ${localRisk} claims across ${county} and force your insurer to pay your maximum settlement. No fee until you get paid.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": `Claim Guardians - ${city}`,
      "image": "https://allclaimguardians.com/images/logo-color.svg",
      "telephone": "(305) 804-5489",
      "url": `https://allclaimguardians.com/service-areas/${city.toLowerCase().replace(/\s+/g, '-')}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": city,
        "addressRegion": stateCode,
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": { "@type": "GeoCoordinates", "description": `${city}, ${county}, ${stateName}` },
        "geoRadius": "50000"
      },
      "makesOffer": zipCodes.map(zip => ({
        "@type": "Offer",
        "eligibleRegion": { "@type": "PostalCode", "postalCode": zip }
      })),
      "description": `Public Adjusting firm serving ${county}, specializing in ${localRisk} claims.`
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allclaimguardians.com/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://allclaimguardians.com/service-areas/" },
        { "@type": "ListItem", "position": 3, "name": city, "item": `https://allclaimguardians.com/service-areas/${city.toLowerCase().replace(/\s+/g, '-')}/` }
      ]
    })} />
  </Fragment>

  <!-- 1. Hero -->
  <header class="relative bg-[#041224] overflow-hidden" style="padding-top:8rem; padding-bottom:8rem;">
    <div class="absolute inset-0 z-0">
      <Image src="/images/hero-city-florida.png" width={1920} height={1080} alt={`${city}, ${stateName} property damage - Claim Guardians service area`} class="w-full h-full object-cover opacity-60 scale-105" fetchpriority="high" loading="eager"/>
      <div class="absolute inset-0 bg-gradient-to-b from-[#041224]/40 via-[#002D51]/20 to-[#041224]"></div>
    </div>
    <div class="section-inner relative z-10">
      <nav aria-label="Breadcrumb" class="mb-10 inline-flex">
        <ol class="flex items-center space-x-2 text-sm text-slate-400 font-medium bg-white/5 backdrop-blur-md px-4 py-2 rounded-full border border-white/10">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li><a href="/service-areas" class="hover:text-white transition-colors">Service Areas</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li class="text-white" aria-current="page">{city}</li>
        </ol>
      </nav>
      <div class="max-w-4xl">
        <span class="eyebrow" style="color:#00B5A6;">Public Adjuster - {county}</span>
