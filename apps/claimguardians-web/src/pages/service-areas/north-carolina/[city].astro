---
import PageHero from "../../../components/PageHero.astro";
import LocalClaimService from '../../../components/LocalClaimService.astro';
import NCServiceLinks from '../../../components/NCServiceLinks.astro';
import MinimalAdLayout from '../../../layouts/MinimalAdLayout.astro';

import MarketReview from '../../../components/MarketReview.astro';
import { getMarketReview } from '../../../data/market-review';

export async function getStaticPaths() {
  const ncCities = [
    {
      city: "Charlotte",
      slug: "charlotte",
      county: "Mecklenburg County",
      localRisk: "severe thunderstorms, hail, and tropical storm remnants",
      zipCodes: ["28202", "28203", "28204", "28205", "28206", "28207", "28208", "28209", "28210", "28211"],
      nearbyAreas: "Concord, Gastonia, Matthews, Huntersville, Mint Hill, Indian Trail, Cornelius, Mooresville, and all of Mecklenburg County",
      damageAngles: {
        primary: "Severe storms and hail",
        primaryDesc: "Charlotte sits in the Carolina hail belt. Severe thunderstorms from March through September regularly produce golf-ball-sized hail that destroys roofs, siding, and vehicles. Insurance companies routinely blame hail damage on 'normal wear and tear' to reduce payouts.",
        secondary: "Wind and tropical storm damage",
        secondaryDesc: "Tropical storm remnants reaching the Charlotte metro can cause significant wind damage, fallen trees, and flooding. Hurricane Hugo (1989) devastated the city, and remnants from Florence (2018) and Helene (2024) caused widespread property damage across Mecklenburg County.",
        tertiary: "Water damage and pipe bursts",
        tertiaryDesc: "Charlotte's clay-heavy soil shifts dramatically between wet and dry seasons, cracking foundations and rupturing pipes. Insurance carriers often classify water damage as 'gradual deterioration' to deny your claim.",
      },

      stats: {
        metric1: { value: "$43.78", label: "average CPC for 'public adjuster charlotte' — proof of high-value market", source: "Google Ads data 2026" },
      }
    },
    {
      city: "Raleigh",
      slug: "raleigh",
      county: "Wake County",
      localRisk: "severe storms, hail, and tropical storm remnants",
      zipCodes: ["27601", "27603", "27604", "27605", "27606", "27607", "27608", "27609", "27610", "27612"],
      nearbyAreas: "Durham, Cary, Apex, Holly Springs, Garner, Wake Forest, Knightdale, and all of Wake County",
      damageAngles: {
        primary: "Hail and wind storms",
        primaryDesc: "The Triangle area experiences intense thunderstorms from spring through fall. Wake County's rapid suburban growth means newer construction is often tested by severe hail and straight-line winds. Insurance adjusters frequently underestimate damage to newer roofing materials.",
        secondary: "Tropical storm and hurricane remnants",
        secondaryDesc: "While inland, Raleigh still receives significant impact from Atlantic hurricanes. Hurricane Florence (2018) dumped record rainfall across Wake County, and Hurricane Matthew (2016) caused widespread flooding. Tropical remnants from Helene (2024) brought destructive winds to the Triangle.",
        tertiary: "Water intrusion and mold",
        tertiaryDesc: "NC's humid climate creates ideal conditions for mold growth after any water event. Insurance companies will deny mold claims if they can argue the damage was 'pre-existing' or 'due to lack of maintenance.' We document the chain of causation to force coverage.",
      },

    },
    {
      city: "Wilmington",
      slug: "wilmington",
      county: "New Hanover County",
      localRisk: "hurricanes, tropical storms, and coastal flooding",
      zipCodes: ["28401", "28403", "28405", "28409", "28411", "28412"],
      nearbyAreas: "Wrightsville Beach, Carolina Beach, Leland, Hampstead, Surf City, Jacksonville, and all of New Hanover and Pender counties",
      damageAngles: {
        primary: "Hurricane and tropical storm damage",
        primaryDesc: "Wilmington is ground zero for Atlantic hurricanes hitting North Carolina. Hurricane Florence (2018) made direct landfall near Wrightsville Beach and caused $24 billion in damage. The city has been hit by more named storms than almost any other US metro. Insurance companies use 'wind vs. water' disputes to deny coastal claims.",
        secondary: "Flood and water damage",
        secondaryDesc: "Coastal NC faces unique flood risks from storm surge, river flooding, and heavy rainfall. Many Wilmington homeowners discover after a storm that their policy excludes certain flood types. We identify every source of coverage and fight for maximum payment.",
        tertiary: "Roof and structural wind damage",
        tertiaryDesc: "Wilmington's hurricane-force winds tear off roofing, damage siding, and compromise structural integrity. Insurance adjusters often claim damage is 'cosmetic' when it actually compromises the building envelope. Our licensed estimators document every deficiency.",
      },

    },
    {
      city: "Asheville",
      slug: "asheville",
      county: "Buncombe County",
      localRisk: "catastrophic flooding, mudslides, and severe storms",
      zipCodes: ["28801", "28803", "28804", "28805", "28806"],
      nearbyAreas: "Hendersonville, Waynesville, Black Mountain, Brevard, Weaverville, and all of Buncombe, Henderson, and Haywood counties",
      damageAngles: {
        primary: "Catastrophic flood damage (Hurricane Helene)",
        primaryDesc: "Hurricane Helene (September 2024) devastated Western North Carolina with unprecedented flooding. The Swannanoa and French Broad rivers reached historic levels, destroying homes, businesses, and infrastructure across Buncombe County. 25% of NC claims after Helene were closed with zero payment. If your claim was denied or underpaid, we fight to reverse that decision.",
        secondary: "Mudslide and landslide damage",
        secondaryDesc: "WNC's mountainous terrain makes properties vulnerable to mudslides after heavy rain events. Insurance companies frequently deny landslide claims, arguing they fall under 'earth movement' exclusions. We challenge these denials with geological evidence and policy analysis.",
        tertiary: "Water intrusion and mold",
        tertiaryDesc: "Post-flood, Asheville homes face severe mold risks from standing water and saturated materials. Insurance companies try to separate mold damage from the original flood event. We document the direct causation chain to ensure full coverage.",
      },

    },
    {
      city: "Fayetteville",
      slug: "fayetteville",
      county: "Cumberland County",
      localRisk: "severe storms, hurricane remnants, and hail",
      zipCodes: ["28301", "28303", "28304", "28305", "28306", "28311", "28314"],
      nearbyAreas: "Fort Liberty (Bragg), Spring Lake, Hope Mills, Sanford, Lumberton, and all of Cumberland County",
      damageAngles: {
        primary: "Storm and hurricane remnant damage",
        primaryDesc: "Fayetteville's position in the Carolina Sandhills means it receives significant impact from Atlantic hurricanes moving inland. Hurricanes Florence (2018), Matthew (2016), and Helene (2024) all caused major damage in Cumberland County. Insurance companies delay and underpay military community claims knowing frequent relocations make follow-up harder.",
        secondary: "Hail and wind damage",
        secondaryDesc: "Severe thunderstorms bringing large hail and damaging winds are common from spring through fall. Cumberland County's mix of older military housing and newer developments creates complex damage assessments that insurance adjusters often undervalue.",
        tertiary: "Water and flood damage",
        tertiaryDesc: "The Cape Fear River basin makes low-lying Fayetteville neighborhoods vulnerable to flooding during major rain events. Insurance carriers dispute whether damage is from covered 'wind-driven rain' or excluded 'rising water.'",
      },

    },
    {
      city: "Jacksonville",
      slug: "jacksonville-nc",
      county: "Onslow County",
      localRisk: "hurricanes, coastal storms, and flooding",
      zipCodes: ["28540", "28546"],
      nearbyAreas: "Camp Lejeune, Swansboro, Richlands, Holly Ridge, Sneads Ferry, and all of Onslow County",
      damageAngles: {
        primary: "Hurricane and coastal storm damage",
        primaryDesc: "Jacksonville's coastal Onslow County position puts it in the direct path of Atlantic hurricanes. Hurricane Florence (2018) caused catastrophic damage across the Camp Lejeune area. Insurance companies use policy technicalities to deny coastal storm claims. We cut through the red tape.",
        secondary: "Flood and water damage",
        secondaryDesc: "Low-lying areas near the New River and coastal zones face serious flood risk during hurricane season. Many Jacksonville homeowners are caught between standard homeowners policies and flood insurance gaps. We identify every coverage avenue.",
        tertiary: "Roof and wind damage",
        tertiaryDesc: "Coastal winds take a heavy toll on roofing and siding in Onslow County. Insurance adjusters often attribute damage to 'wear and tear' or 'maintenance issues' rather than covered storm events. Our licensed estimators prove otherwise.",
      },

    },
  ];

  return ncCities.map((data) => ({
    params: { city: data.slug },
    props: { data },
  }));
}

const { data } = Astro.props;
const { city, slug, county, localRisk, zipCodes, nearbyAreas, damageAngles } = data;
const profile = getMarketReview(city, "NC");
const faq = profile.faq;

---

<MinimalAdLayout
  title={`Public Adjuster in ${city}, NC | Claim Guardians`}
  description={`Property damage in ${city}? Claim Guardians' NC-licensed public adjusters handle your insurance claim from inspection to settlement. No recovery, no fee.`}
>
  <Fragment slot="head">

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faq.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://allclaimguardians.com/" },
        { "@type": "ListItem", "position": 2, "name": "Service Areas", "item": "https://allclaimguardians.com/service-areas/" },
        { "@type": "ListItem", "position": 3, "name": "North Carolina", "item": "https://allclaimguardians.com/service-areas/north-carolina/" },
        { "@type": "ListItem", "position": 4, "name": city, "item": `https://allclaimguardians.com/service-areas/north-carolina/${slug}/` }
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Service",
      "name": `Public Adjusting Services in ${city}, NC`,
      "provider": { "@id": "https://allclaimguardians.com/#organization" },
      "areaServed": { "@type": "AdministrativeArea", "name": county },
      "description": `Licensed public adjusters handling ${localRisk} damage claims in ${city} and ${county}.`,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free inspection. No recovery, no fee." }
    })} />
  </Fragment>

  <!-- 1. HERO -->
  <PageHero title={`Public Adjuster in ${city}, ${"NC"}`} eyebrow={`Property claims / ${county}`} description={`Claim Guardians represents homeowners and business owners in ${county} with property insurance claims. We document damage, review the policy and negotiate with your insurer. Request help with a new claim, a denial or a partial payment.`} image={'/images/hero-hurricane-damage.png'} current={city} parent={{ label: 'North Carolina', href: '/service-areas/north-carolina/' }} ctaHref="#claim-form" compact />

  <LocalClaimService city={city} state="NC" area={county} />

  <!-- 2. LOCAL DAMAGE TYPES (unique per city) -->
  <section class="section-white">
    <div class="section-inner">
      <div class="max-w-3xl mb-12">
        <span class="eyebrow">Why {city} needs Claim Guardians</span>
        <h2 class="section-heading mb-4">Property Damage Risks Specific to {city} and {county}.</h2>
        <p class="text-lg text-slate-500 font-medium leading-relaxed">Insurance companies operating in {county} know these risks — and they train their adjusters to minimize what they pay you. Here's what we fight for.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="card-hover p-8">
          <div class="text-3xl mb-4">🌪️</div>
          <h3 class="text-xl font-extrabold text-[#082142] mb-3">{damageAngles.primary}</h3>
          <p class="text-slate-500 font-medium leading-relaxed">{damageAngles.primaryDesc}</p>
          <a href="/services/hurricane-damage/" class="inline-flex items-center gap-2 mt-4 text-sm font-bold text-[#00808C] hover:text-[#002D51] transition-colors">Learn about our storm claim process →</a>
        </div>
        <div class="card-hover p-8">
          <div class="text-3xl mb-4">💧</div>
          <h3 class="text-xl font-extrabold text-[#082142] mb-3">{damageAngles.secondary}</h3>
          <p class="text-slate-500 font-medium leading-relaxed">{damageAngles.secondaryDesc}</p>
          <a href="/services/water-damage/" class="inline-flex items-center gap-2 mt-4 text-sm font-bold text-[#00808C] hover:text-[#002D51] transition-colors">Learn about our water damage process →</a>
        </div>
        <div class="card-hover p-8">
          <div class="text-3xl mb-4">🏠</div>
          <h3 class="text-xl font-extrabold text-[#082142] mb-3">{damageAngles.tertiary}</h3>
          <p class="text-slate-500 font-medium leading-relaxed">{damageAngles.tertiaryDesc}</p>
          <a href="/services/denied-claims/" class="inline-flex items-center gap-2 mt-4 text-sm font-bold text-[#00808C] hover:text-[#002D51] transition-colors">Learn about denied claim appeals →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. ALL SERVICES GRID -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="max-w-3xl mb-16">
        <span class="eyebrow">Full service</span>
        <h2 class="section-heading mb-4">Every Type of Property Damage Claim in {city}.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/services/water-damage/" class="card-hover p-6 block group">
          <div class="flex items-center gap-4">
            <span class="text-2xl">💧</span>
            <div>
              <h3 class="text-lg font-extrabold text-[#082142] group-hover:text-[#00808C] transition-colors">Water & Leak Damage</h3>
              <p class="text-sm text-slate-500 font-medium">Pipe bursts, hidden moisture, flood</p>
            </div>
          </div>
        </a>
        <a href="/services/hurricane-damage/" class="card-hover p-6 block group">
          <div class="flex items-center gap-4">
            <span class="text-2xl">🌪️</span>
            <div>
              <h3 class="text-lg font-extrabold text-[#082142] group-hover:text-[#00808C] transition-colors">Hurricane & Storm</h3>
              <p class="text-sm text-slate-500 font-medium">Wind, hail, tropical storm impact</p>
            </div>
          </div>
        </a>
        <a href="/services/roof-damage/" class="card-hover p-6 block group">
          <div class="flex items-center gap-4">
            <span class="text-2xl">🏠</span>
            <div>
              <h3 class="text-lg font-extrabold text-[#082142] group-hover:text-[#00808C] transition-colors">Roof Damage</h3>
              <p class="text-sm text-slate-500 font-medium">Structural failures, hail hits, leaks</p>
            </div>
          </div>
        </a>
        <a href="/services/fire-damage/" class="card-hover p-6 block group">
          <div class="flex items-center gap-4">
            <span class="text-2xl">🔥</span>
            <div>
              <h3 class="text-lg font-extrabold text-[#082142] group-hover:text-[#00808C] transition-colors">Fire & Smoke</h3>
              <p class="text-sm text-slate-500 font-medium">Structural loss and smoke assessment</p>
            </div>
          </div>
        </a>
        <a href="/services/mold-claims/" class="card-hover p-6 block group">
          <div class="flex items-center gap-4">
            <span class="text-2xl">🦠</span>
            <div>
              <h3 class="text-lg font-extrabold text-[#082142] group-hover:text-[#00808C] transition-colors">Mold Damage</h3>
              <p class="text-sm text-slate-500 font-medium">Post-water exposure documentation</p>
            </div>
          </div>
        </a>
        <a href="/services/denied-claims/" class="card-hover p-6 block group">
          <div class="flex items-center gap-4">
            <span class="text-2xl">⚖️</span>
            <div>
              <h3 class="text-lg font-extrabold text-[#082142] group-hover:text-[#00808C] transition-colors">Denied & Underpaid</h3>
              <p class="text-sm text-slate-500 font-medium">Appeals and forced full payment</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. PROCESS -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">How it works</span>
        <h2 class="section-heading mb-4">Three Steps to Your Maximum Settlement in {city}.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card-hover p-10">
          <div class="step-number">01</div>
          <h3 class="text-xl font-extrabold text-[#082142] mb-3">Free property inspection</h3>
          <p class="text-slate-500 font-medium">Our NC-licensed adjusters visit your {city} property and document <strong>all</strong> damage — including what insurance adjusters miss. This costs you nothing.</p>
        </div>
        <div class="card-hover p-10">
          <div class="step-number">02</div>
          <h3 class="text-xl font-extrabold text-[#082142] mb-3">We handle the insurance fight</h3>
          <p class="text-slate-500 font-medium">We prepare a comprehensive claim, file all paperwork, and negotiate directly with your insurer. You don't deal with adjusters, calls, or paperwork.</p>
        </div>
        <div class="card-hover p-10">
          <div class="step-number">03</div>
          <h3 class="text-xl font-extrabold text-[#082142] mb-3">You get your maximum settlement</h3>
          <p class="text-slate-500 font-medium">Settlement check in your hands. We collect our fee <strong>only after</strong> you get paid. If we don't recover anything, you owe us nothing.</p>
        </div>
      </div>
    </div>
  </section>

  <NCServiceLinks city={city} />
  <MarketReview profile={profile} />

  <!-- 6. YOUR ADJUSTER VS THEIRS -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Who works for you?</span>
        <h2 class="section-heading">Your Adjuster vs. Their Adjuster.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="rounded-2xl border-2 border-red-200 bg-red-50/50 p-8">
          <h3 class="text-xl font-extrabold text-[#082142] mb-6 flex items-center gap-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-red-100 text-red-500">✕</span>
            Their insurance adjuster
          </h3>
          <ul class="space-y-4 text-slate-600 font-medium">
            <li class="flex items-start gap-3"><span class="text-red-400 mt-0.5">⚠️</span>Paid by the insurance company.</li>
            <li class="flex items-start gap-3"><span class="text-red-400 mt-0.5">⚠️</span>Trained to minimize your payout.</li>
            <li class="flex items-start gap-3"><span class="text-red-400 mt-0.5">⚠️</span>Uses policy jargon to exclude coverage.</li>
            <li class="flex items-start gap-3"><span class="text-red-400 mt-0.5">⚠️</span>May blame damage on "pre-existing conditions."</li>
          </ul>
        </div>
        <div class="rounded-2xl border-2 border-[#00B5A6]/30 bg-[#00808C]/5 p-8">
          <h3 class="text-xl font-extrabold text-[#082142] mb-6 flex items-center gap-3">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-[#00B5A6]/20 text-[#00808C]">✓</span>
            Claim Guardians (your PA)
          </h3>
          <ul class="space-y-4 text-slate-600 font-medium">
            <li class="flex items-start gap-3"><span class="text-[#00B5A6] mt-0.5">✓</span><strong>You</strong> hire us. We work for you.</li>
            <li class="flex items-start gap-3"><span class="text-[#00B5A6] mt-0.5">✓</span>We maximize your financial settlement.</li>
            <li class="flex items-start gap-3"><span class="text-[#00B5A6] mt-0.5">✓</span>We document every detail of damage.</li>
            <li class="flex items-start gap-3"><span class="text-[#00B5A6] mt-0.5">✓</span>No recovery, no fee. Zero risk.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. COVERAGE ZIP CODES -->
  <section class="section-muted">
    <div class="section-inner text-center">
      <span class="eyebrow">Local coverage</span>
      <h2 class="section-heading mb-4">Serving {city} and All of {county}.</h2>
      <p class="text-lg text-slate-500 mb-8 max-w-2xl mx-auto font-medium">
        Our field adjusters respond to claims in {city} and surrounding areas including {nearbyAreas}.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {zipCodes.map((zip) => (
          <div class="px-5 py-2.5 bg-white border border-slate-200 rounded-full shadow-sm text-base font-bold text-[#002D51]">
            {zip}
          </div>
        ))}
        <div class="px-5 py-2.5 bg-white border border-slate-200 rounded-full shadow-sm text-base font-bold text-slate-400">
          + All surrounding areas
        </div>
      </div>
      <a href="/service-areas/north-carolina/" class="inline-flex items-center gap-2 text-sm font-bold text-[#00808C] hover:text-[#002D51] transition-colors">
        ← View all NC service areas
      </a>
    </div>
  </section>

  <!-- 8. FAQ -->
  <section class="section-white">
    <div class="section-inner max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <span class="eyebrow">Common questions</span>
        <h2 class="section-heading">Questions from {city} Homeowners.</h2>
      </div>
      <div class="space-y-4">
        {faq.map((item) => (
          <details class="group bg-white border border-slate-200 rounded-2xl overflow-hidden">
            <summary class="flex justify-between items-center px-8 py-6 cursor-pointer font-bold text-[#082142] text-lg hover:bg-slate-50 transition-colors">
              <span>{item.q}</span>
              <svg class="w-5 h-5 text-slate-400 transition-transform group-open:rotate-180 flex-shrink-0 ml-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="px-8 pb-6 text-slate-500 font-medium leading-relaxed">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. FINAL CTA + FORM -->



  <section class="section-muted">
    <div class="section-inner max-w-4xl">
      <h2 class="section-heading mb-4">What should you bring to a claim review?</h2>
      <p class="text-lg text-slate-700 leading-relaxed mb-5">Bring your policy, dated photos, repair estimates or reports, and any insurer letters. If the claim was denied or paid, include the decision and a timeline of communication. The review considers your policy and documented damage; it does not guarantee coverage or a particular settlement.</p>
      <div class="flex flex-wrap gap-5"><a class="text-[#006775] font-bold underline" href="/resources/claim-review-guide/">Read the claim review guide</a><a class="text-[#006775] font-bold underline" lang="es" href="/es/guia-reclamacion/">Guía de reclamaciones en español</a></div>
    </div>
  </section>
</MinimalAdLayout>
