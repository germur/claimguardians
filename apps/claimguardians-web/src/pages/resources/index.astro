---
import PageHero from "../../components/PageHero.astro";
import { editorialGuides, guideHref } from '../../data/editorial-guides';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Insurance Claim Resources - Public Adjuster Guides & Terms | Claim Guardians"
  description="Property insurance claim resources: understand policy terms, prepare damage records, check credentials and explore claim review questions."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is a Public Adjuster in Florida?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A public adjuster is a licensed professional hired by a policyholder to assist with documenting and negotiating an insurance claim within an agreed scope. Claim Guardians discusses homeowners and commercial property damage claims."
            }
          },
          {
            "@type": "Question",
            "name": "How can I check the Florida adjuster’s credentials?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Principal adjuster Alejandro Sibila’s Florida individual record is W116187, linked on our company page and checked on October 19, 2026. Verify the assigned professional’s current status and any applicable firm credentials before engagement; individual and firm records are separate."
            }
          },
          {
            "@type": "Question",
            "name": "Why should I trust Claim Guardians with my property claim?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evaluate the assigned professional, current license records, communication plan and written scope, fees and expenses. Our company page identifies the principal adjuster and links the Florida and North Carolina individual records checked on October 19, 2026."
            }
          },
          {
            "@type": "Question",
            "name": "How does the Claim Guardians process work?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Start with a free initial review of the property and claim situation. If representation is appropriate, confirm the professional, inspection availability and written terms. Work then follows the agreed scope, with documentation and communication about the insurer’s response."
            }
          },
          {
            "@type": "Question",
            "name": "How long does a property damage claim take in Florida?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Timing varies with the loss, access, documentation, coverage questions and insurer response. Keep a communication timeline and ask what information is outstanding. Do not wait for our review before reporting a loss or seeking advice about a deadline."
            }
          },
          {
            "@type": "Question",
            "name": "Can I hire Claim Guardians if my insurance claim was denied?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "You can request a review of a denied or partially paid property claim. Bring the written decision, policy, estimates and supporting evidence. Further options depend on the claim history and applicable deadlines; reopening or additional payment is not guaranteed."
            }
          },
          {
            "@type": "Question",
            "name": "How much does a public adjuster cost in Florida?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The initial claim review is free. Before representation, ask for a written agreement explaining the scope, fee calculation, payment timing, any inspection or third-party expenses, and cancellation terms. Do not assume every expense is included."
            }
          },
          {
            "@type": "Question",
            "name": "Do public adjuster fees reduce my final insurance payout?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fees and any agreed expenses affect the amount you retain. Ask for the calculation and payment terms in writing and consider deductibles, limits and any prior payments. There is no reliable increase or net payment to promise for an individual claim."
            }
          },
          {
            "@type": "Question",
            "name": "Will hiring a public adjuster get my insurance policy canceled?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Questions about cancellation or renewal depend on the policy and circumstances. Ask your insurer or the Florida Department of Financial Services to explain a specific notice, and seek qualified legal advice where appropriate. Hiring representation does not resolve every coverage or renewal issue."
            }
          },
          {
            "@type": "Question",
            "name": "What areas in Florida does Claim Guardians serve?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Claim Guardians publishes Florida service areas including Miami, Fort Lauderdale, Orlando, Tampa and Fort Myers. Contact us to confirm the assigned professional and inspection availability for your property."
            }
          },
          {
            "@type": "Question",
            "name": "What should I do immediately after property damage?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Follow emergency officials’ directions and address urgent safety needs. When safe, preserve dated photographs, reports and receipts, and contact your insurer promptly about reporting requirements. A public adjuster review should not delay required notification or emergency help."
            }
          }
        ]
      }
    </script>
  </Fragment>

  <!-- 1. Hero Section -->
  <PageHero title={"Property claim resources."} emphasis={"A little more clarity."} eyebrow={"Guides / Questions / Insurance terms"} description={"Find explanations, preparation guides and questions to bring to a claim review. Search the resources below or choose a topic."} current={"Resources"} ctaLabel={""}><div data-resource-search hidden class="relative max-w-2xl"><label for="resource-search" class="block mb-3">Search questions and guides</label><input type="search" id="resource-search" aria-controls="resource-content" placeholder="Search insurance terms, guides, or questions..." class="w-full px-4 py-4" /></div></PageHero>

  <!-- 2. Knowledge Categories -->
  <section class="section-white">
    <div class="section-inner relative z-20">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Card 1 (Guides) -->
        <a href="/resources/claim-review-guide/" class="card-hover p-8 md:p-12 group">
          <div class="text-5xl mb-6">📚</div>
          <h3 class="text-3xl font-black text-[#082142] mb-4 group-hover:text-[#00808C] transition-colors">Claim Survival Guides</h3>
          <p class="text-lg text-slate-500 font-medium">A practical checklist to prepare your documents for a property claim review.</p>
        </a>

        <!-- Card 2 (Glossary) -->
        <a href="#glossary" class="card-hover p-8 md:p-12 group">
          <div class="text-5xl mb-6">📖</div>
          <h3 class="text-3xl font-black text-[#082142] mb-4 group-hover:text-[#00808C] transition-colors">Insurance Glossary</h3>
          <p class="text-lg text-slate-500 font-medium">Plain-English definitions to help you read your policy and claim correspondence.</p>
        </a>

        <!-- Card 3 (Comparisons) -->
        <a href="#adjuster-comparison" class="card-hover p-8 md:p-12 group">
          <div class="text-5xl mb-6">⚖️</div>
          <h3 class="text-3xl font-black text-[#082142] mb-4 group-hover:text-[#00808C] transition-colors">Who Does an Adjuster Represent?</h3>
          <p class="text-lg text-slate-500 font-medium">The critical difference between public adjusters and your insurance company's "staff" adjusters.</p>
        </a>

        <!-- Card 4 (Legal Rights) -->
        <a href="#licensing" class="card-hover p-8 md:p-12 group">
          <div class="text-5xl mb-6">🛡️</div>
          <h3 class="text-3xl font-black text-[#082142] mb-4 group-hover:text-[#00808C] transition-colors">Licensing & Trust</h3>
          <p class="text-lg text-slate-500 font-medium">Learn about professional licensing and choosing a public adjuster.</p>
        </a>
      </div>
    </div>
  </section>

  <div id="resource-content">
  <section class="section-muted">
    <div class="section-inner max-w-4xl space-y-8">
      <p id="search-status" role="status" aria-live="polite" class="text-slate-700"></p>
      <div id="search-empty" hidden class="rounded-2xl bg-white border border-slate-200 p-6">
        <p>No matching questions or guides. Try another term, or <a href="/contact/" class="underline text-[#006775]">contact our team</a>.</p>
        <button id="search-clear" type="button" class="btn-secondary mt-4">Show all resources</button>
      </div>
      <section data-search-group aria-labelledby="property-claim-guides">
        <h2 id="property-claim-guides" class="section-heading mb-6">Guides for common claim decisions</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {editorialGuides.map(guide => <article data-search-item class="bg-white border border-slate-200 rounded-2xl p-5">
            <p class="eyebrow mb-2">{guide.category}</p>
            <h3 class="text-xl font-bold"><a class="underline text-[#006775]" href={guideHref(guide.slug)}>{guide.heading}</a></h3>
            <p class="mt-3 text-slate-600">{guide.description}</p>
          </article>)}
        </div>
      </section>
      <article id="claim-guide" data-search-item class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8">
        <h2 class="section-heading mb-4">Prepare for a property claim review</h2>
        <p class="mb-4"><a class="underline text-[#006775]" href="/resources/claim-review-guide/">Read the complete guide</a> · <a lang="es" class="underline text-[#006775]" href="/es/guia-reclamacion/">Leer en español</a></p>
        <ol class="list-decimal pl-6 space-y-3 text-slate-700">
          <li>Gather your insurance policy, declarations page, and claim number if you have one.</li>
          <li>Keep dated photos of the damage, taken only from areas you can access safely.</li>
          <li>Collect inspection reports, repair estimates, receipts, and an inventory of damaged items.</li>
          <li>Bring any insurer letters, offers, or denial explanations, and a short timeline of what happened.</li>
        </ol>
        <p class="mt-4 text-slate-600">Missing a document? You can still request a review and tell us what you have.</p>
      </article>
      <article id="glossary" data-search-item class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8">
        <h2 class="section-heading mb-4">Insurance glossary</h2>
        <dl class="space-y-4 text-slate-700">
          <div><dt class="font-bold">Declarations page</dt><dd>A summary of the policy, insured property, coverage limits, and deductibles.</dd></div>
          <div><dt class="font-bold">Deductible</dt><dd>The amount the policy makes your responsibility for a covered loss. The applicable amount depends on the policy and loss.</dd></div>
          <div><dt class="font-bold">Coverage limit</dt><dd>The maximum payable for a particular coverage, subject to the policy terms.</dd></div>
          <div><dt class="font-bold">Estimate</dt><dd>An assessment of the work and cost to repair damage. It is not a guarantee of insurance payment.</dd></div>
        </dl>
      </article>
      <article id="adjuster-comparison" data-search-item class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8">
        <h2 class="section-heading mb-4">Who does an adjuster represent?</h2>
        <p class="text-slate-700 mb-3">A staff adjuster is employed by an insurer. An independent adjuster may be engaged by an insurer to assess a claim. A public adjuster is hired by the policyholder to represent the policyholder in the claim process.</p>
        <p class="text-slate-700">Before engaging a professional, <a class="underline text-[#006775]" href="/resources/what-is-a-public-adjuster/#verify-adjuster-license">look up their public adjuster license</a> and ask for a written explanation of their role, services and fees.</p>
      </article>
    </div>
  </section>

  <!-- 3. Categorized FAQ (High Authority) -->
  <section id="faq" class="section-muted border-t border-slate-200">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Expert Audit</span>
        <h2 class="section-heading text-[#082142]">Understand the claim. Prepare your questions.</h2>
        <p class="text-slate-500 mt-4 max-w-2xl mx-auto font-medium">Practical answers to common property insurance claim questions.</p>
      </div>

      <div id="faq-groups" class="space-y-16 max-w-4xl mx-auto">
        
        <!-- Category 1: Trust & Credibility -->
        <div id="licensing" data-search-group>
          <div class="flex items-center gap-4 mb-10">
            <div class="h-px flex-grow bg-slate-200"></div>
            <h3 class="text-sm font-black uppercase tracking-[0.3em] text-[#00808C] text-center">Professional Licensing & Trust</h3>
            <div class="h-px flex-grow bg-slate-200"></div>
          </div>
          <div class="space-y-8">
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">1. What is a Public Adjuster in Florida?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">A public adjuster is a licensed professional hired by a policyholder to assist with documenting and negotiating an insurance claim within an agreed scope. Claim Guardians discusses homeowners and commercial property damage claims.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">2. How can I check the Florida adjuster’s credentials?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Principal adjuster Alejandro Sibila’s Florida individual record is W116187, linked on our company page and checked on October 19, 2026. Verify the assigned professional’s current status and any applicable firm credentials before engagement; individual and firm records are separate.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">3. Why should I trust Claim Guardians with my property claim?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Evaluate the assigned professional, current license records, communication plan and written scope, fees and expenses. Our company page identifies the principal adjuster and links the Florida and North Carolina individual records checked on October 19, 2026.</p>
            </div>
          </div>
        </div>

        <!-- Category 2: Process & Value -->
        <div data-search-group>
          <div class="flex items-center gap-4 mb-10">
            <div class="h-px flex-grow bg-slate-200"></div>
            <h3 class="text-sm font-black uppercase tracking-[0.3em] text-[#00808C] text-center">Process & Value</h3>
            <div class="h-px flex-grow bg-slate-200"></div>
          </div>
          <div class="space-y-8">
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">4. How does the Claim Guardians process work?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Start with a free initial review of the property and claim situation. If representation is appropriate, confirm the professional, inspection availability and written terms. Work then follows the agreed scope, with documentation and communication about the insurer’s response.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">5. How long does a property damage claim take in Florida?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Timing varies with the loss, access, documentation, coverage questions and insurer response. Keep a communication timeline and ask what information is outstanding. Do not wait for our review before reporting a loss or seeking advice about a deadline.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">6. Can I hire Claim Guardians if my insurance claim was denied?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">You can request a review of a denied or partially paid property claim. Bring the written decision, policy, estimates and supporting evidence. Further options depend on the claim history and applicable deadlines; reopening or additional payment is not guaranteed.</p>
            </div>
          </div>
        </div>

        <!-- Category 3: Costs & Risks -->
        <div data-search-group>
          <div class="flex items-center gap-4 mb-10">
            <div class="h-px flex-grow bg-slate-200"></div>
            <h3 class="text-sm font-black uppercase tracking-[0.3em] text-[#00808C] text-center">Costs & Risks</h3>
            <div class="h-px flex-grow bg-slate-200"></div>
          </div>
          <div class="space-y-8">
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">7. How much does a public adjuster cost in Florida?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">The initial claim review is free. Before representation, ask for a written agreement explaining the scope, fee calculation, payment timing, any inspection or third-party expenses, and cancellation terms. Do not assume every expense is included.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">8. Do public adjuster fees reduce my final insurance payout?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Fees and any agreed expenses affect the amount you retain. Ask for the calculation and payment terms in writing and consider deductibles, limits and any prior payments. There is no reliable increase or net payment to promise for an individual claim.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">9. Will hiring a public adjuster get my insurance policy canceled?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Questions about cancellation or renewal depend on the policy and circumstances. Ask your insurer or the Florida Department of Financial Services to explain a specific notice, and seek qualified legal advice where appropriate. Hiring representation does not resolve every coverage or renewal issue.</p>
            </div>
          </div>
        </div>

        <!-- Category 4: Urgency & Action -->
        <div data-search-group>
          <div class="flex items-center gap-4 mb-10">
            <div class="h-px flex-grow bg-slate-200"></div>
            <h3 class="text-sm font-black uppercase tracking-[0.3em] text-[#00808C] text-center">Urgency & Action</h3>
            <div class="h-px flex-grow bg-slate-200"></div>
          </div>
          <div class="space-y-8">
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">10. What areas in Florida does Claim Guardians serve?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Claim Guardians publishes Florida service areas including Miami, Fort Lauderdale, Orlando, Tampa and Fort Myers. Contact us to confirm the assigned professional and inspection availability for your property.</p>
            </div>
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
              <div class="absolute left-0 top-0 bottom-0 w-2 bg-[#00B5A6]"></div>
              <h4 class="text-2xl font-black text-[#082142] mb-6">11. What should I do immediately after property damage?</h4>
              <p class="text-lg text-slate-600 leading-relaxed font-medium">Follow emergency officials’ directions and address urgent safety needs. When safe, preserve dated photographs, reports and receipts, and contact your insurer promptly about reporting requirements. A public adjuster review should not delay required notification or emergency help.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  </div>

  <!-- 4. Final CTA -->
  <section class="gradient-accent-bar section-white text-center">
    <div class="section-inner">
      <h2 class="section-heading mb-6">Empower Your Claim with Professional Expertise.</h2>
      <p class="text-xl text-slate-500 mb-10 font-medium max-w-2xl mx-auto">
        Tell us what happened, where the property is located and what your insurer has said so far.
      </p>
      <a href="/free-claim-review/" class="btn-accent px-12 py-5 text-2xl min-h-[64px]">Request Your Free Claim Review →</a>
    </div>
  </section>

  <script>
    const search = document.getElementById('resource-search') as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search-item]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-search-group]'));
    const status = document.getElementById('search-status');
    const empty = document.getElementById('search-empty');
    const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    function filterResources() {
      const query = normalize(search?.value.trim() || '');
      let count = 0;
      for (const item of items) {
        item.hidden = !normalize(item.textContent || '').includes(query);
        if (!item.hidden) count++;
      }
      for (const group of groups) group.hidden = !group.querySelector('[data-search-item]:not([hidden])');
      if (status) status.textContent = query ? `${count} matching resource${count === 1 ? '' : 's'}` : '';
      if (empty) empty.hidden = count > 0;
    }
    document.querySelector<HTMLElement>('[data-resource-search]')?.removeAttribute('hidden');
    search?.addEventListener('input', filterResources);
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        if (search && search.value && document.querySelector(link.hash)?.closest('#resource-content')) {
          search.value = '';
          filterResources();
        }
      });
    });
    document.getElementById('search-clear')?.addEventListener('click', () => {
      if (search) { search.value = ''; filterResources(); search.focus(); }
    });
  </script>
</BaseLayout>
