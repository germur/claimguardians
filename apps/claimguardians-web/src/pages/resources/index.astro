  </div>

  <!-- 4. Final CTA -->
  <section class="gradient-accent-bar section-white text-center">
    <div class="section-inner">
      <h2 class="section-heading mb-6">Empower Your Claim with Professional Expertise.</h2>
      <p class="text-xl text-slate-500 mb-10 font-medium max-w-2xl mx-auto">
        Don't let them win with legal jargon. Let Claim Guardians handle the technical battle for you.
      </p>
      <a href="/free-claim-review/" class="btn-accent px-12 py-5 text-2xl min-h-[64px]">Secure Your Full Check →</a>
    </div>
  </section>

  <script>
    const search = document.getElementById('resource-search') as HTMLInputElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search-item]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-search-group]'));
    const status = document.getElementById('search-status');
    const empty = document.getElementById('search-empty');
    const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    function filterResources() {
      const query = normalize(search?.value.trim() || '');
      let count = 0;
      for (const item of items) {
        item.hidden = !normalize(item.textContent || '').includes(query);
        if (!item.hidden) count++;
      }
      for (const group of groups) group.hidden = !group.querySelector('[data-search-item]:not([hidden])');
      if (status) status.textContent = query ? `${count} matching resource${count === 1 ? '' : 's'}` : '';
      if (empty) empty.hidden = count > 0;
    }
    document.querySelector<HTMLElement>('[data-resource-search]')?.removeAttribute('hidden');
    search?.addEventListener('input', filterResources);
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(link => {
      link.addEventListener('click', () => {
        if (search && search.value && document.querySelector(link.hash)?.closest('#resource-content')) {
          search.value = '';
          filterResources();
        }
      });
    });
    document.getElementById('search-clear')?.addEventListener('click', () => {
      if (search) { search.value = ''; filterResources(); search.focus(); }
    });
  </script>
</BaseLayout>
