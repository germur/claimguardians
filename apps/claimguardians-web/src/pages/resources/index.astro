        <!-- Category 4: Urgency & Action -->
        <div data-search-group>
          <div class="flex items-center gap-4 mb-10">
            <div class="h-px flex-grow bg-slate-200"></div>
            <h3 class="text-sm font-black uppercase tracking-[0.3em] text-[#00808C] text-center">Urgency & Action</h3>
            <div class="h-px flex-grow bg-slate-200"></div>
          </div>
          <div class="space-y-8">
            <div data-search-item class="bg-white rounded-3xl p-6 md:p-10 border-2 border-slate-100 shadow-sm relative overflow-hidden group hover:border-[#00808C] transition-all">
