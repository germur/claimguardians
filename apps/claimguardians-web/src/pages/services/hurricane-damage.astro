---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimCalculator from '../../components/ClaimCalculator';
import EligibilityTest from '../../components/EligibilityTest';
---

<BaseLayout 
  title="Hurricane Damage Public Adjuster Florida - Storm Claim Help | Claim Guardians"
  description="Hurricane damage public adjuster in Florida. We document wind, hail, and structural storm damage and force your insurer to pay the full cost of recovery."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Hurricane Damage Public Adjuster",
        "provider": { "@type": "LocalBusiness", "name": "Claim Guardians LLC" },
        "areaServed": [{ "@type": "State", "name": "Florida" }, { "@type": "State", "name": "California" }, { "@type": "State", "name": "North Carolina" }],
        "description": "Hurricane damage public adjuster in Florida. We document wind, hail, and structural storm damage and force your insurer to pay the full cost of recovery."
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
          "@type": "Question",
          "name": "How long do I have to file a hurricane damage claim in Florida?",
          "acceptedAnswer": { "@type": "Answer", "text": "Florida law requires you to report property damage to your insurer promptly. For most homeowner policies, you should file within one year of the hurricane event. Filing sooner gives you a stronger claim." }
        }, {
          "@type": "Question",
          "name": "What is the hurricane deductible in Florida?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most Florida policies have a separate hurricane deductible, typically 2% to 5% of your dwelling coverage limit. On a $400,000 home, that means $8,000 to $20,000 out of pocket before coverage kicks in." }
        }, {
          "@type": "Question",
          "name": "Does hurricane insurance cover water damage from rain?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, if wind first damages the building envelope and rain enters through that opening, the resulting water damage is covered under your windstorm policy. This is called wind-driven rain." }
        }, {
          "@type": "Question",
          "name": "Can I hire a public adjuster after my hurricane claim was denied?",
          "acceptedAnswer": { "@type": "Answer", "text": "Absolutely. Claim Guardians re-inspects your property, gathers new evidence, and files a formal appeal. We have reversed hundreds of hurricane claim denials across Florida." }
        }, {
          "@type": "Question",
          "name": "How much more can a public adjuster get for my hurricane claim?",
          "acceptedAnswer": { "@type": "Answer", "text": "Studies show policyholders who use public adjusters receive settlements 30% to 700% higher than those who negotiate alone. Claim Guardians works on contingency, so you only pay if we increase your settlement." }
        }]
      }
    </script>
  </Fragment>

  <!-- 1. Hero -->
  <header class="relative bg-[#041224] overflow-hidden" style="padding-top:8rem; padding-bottom:8rem;">
    <div class="absolute inset-0 z-0">
      <img src="/images/hero-hurricane-damage.png" alt="Hurricane storm damage to Florida neighborhood" class="w-full h-full object-cover opacity-60 scale-105" fetchpriority="high" loading="eager"/>
      <div class="absolute inset-0 bg-gradient-to-b from-[#041224]/40 via-[#002D51]/20 to-[#041224]"></div>
    </div>
    <div class="section-inner relative z-10">
      <nav aria-label="Breadcrumb" class="mb-10 inline-flex">
        <ol class="flex items-center space-x-2 text-sm text-slate-400 font-medium bg-white/5 px-4 py-2 rounded-full border border-white/10">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li><a href="/services/" class="hover:text-white transition-colors">Services</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li class="text-white" aria-current="page">Hurricane Damage</li>
        </ol>
      </nav>
      <div class="max-w-4xl">
        <span class="eyebrow" style="color:#00B5A6;">Property Damage — Hurricane &amp; Storm</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white mb-8 leading-[1.1] tracking-tight">
          Hurricane Damage Public Adjuster - We Force Full Storm Payouts.
        </h1>
        <p class="text-xl text-slate-300 mb-12 leading-relaxed max-w-3xl">
          Hurricane season devastates Florida properties. Insurance companies minimize payouts by disputing wind damage and storm surge. Claim Guardians forces your insurer to pay the full cost of your hurricane recovery.
        </p>
        <div class="flex flex-col sm:flex-row gap-5 mb-12">
          <a href="/free-claim-review/" class="btn-accent px-10 py-5 text-lg min-h-[60px]">Get a Free Hurricane Damage Inspection</a>
          <a href="tel:3058045489" class="inline-flex justify-center items-center px-10 py-5 text-lg font-bold text-white bg-white/5 border-2 border-white/20 rounded-xl hover:bg-white/10 transition-all transform hover:-translate-y-1 min-h-[60px]">Call a Storm Expert Now</a>
        </div>
        <div class="flex flex-wrap items-center gap-x-10 gap-y-4 pt-6 border-t border-white/10">
          <div class="flex items-center gap-2 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> Florida DFS Licensed</div>
          <div class="flex items-center gap-2 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> No Recovery, No Fee</div>
          <div class="flex items-center gap-2 text-slate-300 font-semibold text-sm"><span class="text-[#00B5A6]">✓</span> Catastrophic Loss Specialists</div>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Problem / Solution -->
  <section class="section-white">
    <div class="section-inner">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <span class="eyebrow">The Problem</span>
          <h2 class="section-heading mb-6">Insurers Dispute Wind and Surge Damage to Protect Profits.</h2>
          <p class="text-lg text-slate-500 leading-relaxed">
            After a hurricane, insurance adjusters rush inspections. They classify wind damage as "pre-existing wear" and dispute storm surge as a "flood" (often excluded from standard policies). Your settlement suffers.
          </p>
        </div>
        <div class="card-hover p-10">
          <h3 class="text-2xl font-bold text-[#082142] mb-6 flex items-center gap-3">
            <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-[#002D51]/10 text-[#00808C]">✓</span>
            Claim Guardians Fights for Every Dollar.
          </h3>
          <ul class="space-y-5">
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">🌀</span><span class="text-lg font-medium text-[#082142]">We document all wind uplift, flying debris, and structural failures.</span></li>
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">🏗️</span><span class="text-lg font-medium text-[#082142]">We source licensed contractor estimates for full rebuilds.</span></li>
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">⚖️</span><span class="text-lg font-medium text-[#082142]">We force your insurer to honor the total policy value for catastrophic losses.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Hurricane Insurance Covers -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Policy Education</span>
        <h2 class="section-heading">What Does Hurricane Insurance Cover in Florida?</h2>
        <p class="text-lg text-slate-500 max-w-3xl mx-auto mt-4">Florida homeowners policies typically cover wind damage from hurricanes, but insurance companies use complex language to limit your payout. Understanding your coverage is the first step to getting paid in full.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card-hover group">
          <div class="text-4xl mb-4">🌀</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Wind Damage</h3>
          <p class="text-slate-500">Roof shingle loss, siding damage, broken windows, and structural displacement caused by hurricane-force winds. Your insurer must cover repairs to restore the property to its pre-storm condition.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🌧️</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Rain Damage After Wind</h3>
          <p class="text-slate-500">When wind breaches your roof or walls, the resulting water intrusion is covered under your windstorm policy. Insurers often try to reclassify this as "flood damage" to deny your claim.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🏗️</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Structural Damage</h3>
          <p class="text-slate-500">Foundation shifting, load-bearing wall cracks, and truss failures caused by sustained hurricane winds. These require engineering reports that insurance adjusters rarely commission on their own.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🌳</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Debris & Tree Impact</h3>
          <p class="text-slate-500">Trees and flying debris that strike your roof, walls, or vehicles during a hurricane. Your policy covers removal costs and structural repairs from impact damage.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Power Surge & Electrical</h3>
          <p class="text-slate-500">Lightning strikes and power surges during hurricanes destroy HVAC systems, appliances, and electrical panels. These losses are often overlooked by insurance adjusters.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🏠</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Additional Living Expenses</h3>
          <p class="text-slate-500">If your home is uninhabitable after a hurricane, your policy covers hotel stays, meals, and temporary housing while repairs are completed. Claim Guardians ensures you receive every dollar of ALE coverage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Our Claims Process -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">How It Works</span>
        <h2 class="section-heading">Our Hurricane Damage Claims Process</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="step-number mx-auto">1</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Free Storm Inspection</h3>
          <p class="text-slate-500">We dispatch a licensed adjuster to your property within 24 hours. We inspect the roof, structure, interior, and exterior for all hurricane-related damage.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">2</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Forensic Documentation</h3>
          <p class="text-slate-500">We photograph every point of damage, use drone inspections for roof access, and commission engineering reports when structural damage is suspected.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">3</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Claim Filing & Negotiation</h3>
          <p class="text-slate-500">We prepare a detailed scope of loss with licensed contractor estimates and submit directly to your insurer. We handle all communication and negotiate aggressively on your behalf.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">4</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Maximum Settlement</h3>
          <p class="text-slate-500">We force your insurer to honor the full policy value. If they refuse, we escalate through Florida's appraisal process or connect you with a property damage attorney.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Result Proof -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Proven Results</span>
        <h2 class="section-heading">We Turn Denied Claims into Full Payouts.</h2>
      </div>
      <div class="max-w-3xl mx-auto card-testimonial">
        <span class="inline-flex px-4 py-2 bg-blue-50 text-[#002D51] text-sm font-bold rounded-full mb-8 border border-blue-100">📍 Hurricane Ian Roof &amp; Structural Damage, Fort Myers, FL.</span>
        <div class="space-y-6 mb-8 pb-8 border-b border-slate-100">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
            <span class="text-slate-500 font-medium text-sm uppercase">Insurance Initial Offer</span>
            <span class="text-red-400 line-through font-bold text-2xl">$31,000</span>
          </div>
          <div class="h-px w-full bg-gradient-to-r from-transparent via-slate-100 to-transparent"></div>
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
            <span class="text-[#082142] font-bold text-sm uppercase">Claim Guardians Settlement</span>
            <span class="text-green-600 font-black text-4xl tracking-tighter">$198,500</span>
          </div>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 grayscale opacity-60">
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">🏛️</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">DFS Licensed</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">🛡️</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">Policyholder Advocacy</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">⚖️</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">State Bonded</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">💰</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">No-Fee Guarantee</span>
        </div>
      </div>
        <div class="bg-slate-50 -mx-10 -mb-10 p-10 rounded-b-3xl">
          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Action Taken</h4>
          <p class="text-xl font-medium text-[#082142] leading-relaxed">We documented full structural displacement and forced coverage for complete rebuild under Florida's Valued Policy Law.</p>
        </div>
      </div>

      <div class="mt-24 max-w-4xl mx-auto">
        <ClaimCalculator client:visible />
      </div>
    </div>
  </section>

  <section class="section-white border-t border-slate-100">
     <div class="section-inner">
       <div class="text-center mb-16">
         <span class="eyebrow">Storm Damage Review</span>
         <h2 class="section-heading">Qualify Your Hurricane Claim For <span class="text-[#00808C]">a Legal Audit.</span></h2>
       </div>
       <EligibilityTest client:visible />
     </div>
  </section>

  <!-- FAQs -->
  <section class="section-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="eyebrow">Common Questions</span>
        <h2 class="section-heading">Frequently Asked Questions About Hurricane Damage Claims</h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How long do I have to file a hurricane damage claim in Florida?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Florida law requires you to report property damage to your insurer promptly. For most homeowner policies, you should file within one year of the hurricane event. However, filing sooner gives you a stronger claim. Claim Guardians helps you file correctly the first time to avoid delays and denials.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>What is the hurricane deductible in Florida?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Most Florida policies have a separate hurricane deductible, typically 2% to 5% of your dwelling coverage limit. On a $400,000 home, that means $8,000 to $20,000 out of pocket before coverage kicks in. Claim Guardians maximizes your gross settlement so the net amount after your deductible is as high as possible.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>Does hurricane insurance cover water damage from rain?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Yes, if wind first damages the building envelope (roof, walls, windows) and rain enters through that opening, the resulting water damage is covered under your windstorm policy. This is called "wind-driven rain." Insurance companies frequently try to classify this as flood damage, which requires a separate policy. Claim Guardians documents the wind breach to prove your water damage is covered.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>Can I hire a public adjuster after my hurricane claim was denied?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Absolutely. Many of our clients come to us after their hurricane claim has been denied or underpaid. Claim Guardians re-inspects your property, gathers new evidence, and files a formal appeal. We have reversed hundreds of hurricane claim denials across Florida.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How much more can a public adjuster get for my hurricane claim?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Studies show policyholders who use public adjusters receive settlements 30% to 700% higher than those who negotiate alone. The exact amount depends on your damage, your policy limits, and how aggressively your insurer contests the claim. Claim Guardians works on contingency, so you only pay if we increase your settlement.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-12">
        <span class="eyebrow">Related Services</span>
        <h2 class="section-heading">Hurricane Damage Often Leads to Other Claims</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/roof-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Roof Damage Claims</h3>
          <p class="text-slate-500">Wind lifts shingles and damages decking. We force full roof replacement coverage.</p>
        </a>
        <a href="/services/water-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Water Damage Claims</h3>
          <p class="text-slate-500">Wind-driven rain causes interior flooding. We document and recover every dollar.</p>
        </a>
        <a href="/services/mold-claims/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Mold Damage Claims</h3>
          <p class="text-slate-500">Standing water from hurricanes breeds mold within 48 hours. We prove the connection.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="gradient-accent-bar section-white text-center">
    <div class="section-inner">
      <span class="eyebrow">No-Risk Consultation</span>
      <h2 class="section-heading mb-4">Did a Hurricane Damage Your Florida Property?</h2>
      <p class="text-xl text-slate-500 mb-8 max-w-2xl mx-auto">Don't settle for what the insurance company offers. Get the maximum payout you're legally owed.</p>
      <a href="/free-claim-review/" class="btn-accent px-12 py-5 text-xl min-h-[64px]">Start Free Hurricane Claim Review →</a>
      <p class="text-sm text-slate-400 mt-4">Zero upfront cost. Ever.</p>
    </div>
  </section>

  <div class="fixed bottom-0 left-0 right-0 p-4 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] z-50 sm:hidden">
    <a href="tel:3058045489" class="btn-accent w-full text-lg">🚨 Emergency? Call Now</a>
  </div>
</BaseLayout>
