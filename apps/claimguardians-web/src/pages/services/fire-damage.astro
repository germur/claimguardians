---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EligibilityTest from '../../components/EligibilityTest';
---

<BaseLayout 
  title="Fire Damage Public Adjuster Florida & California | Claim Guardians"
  description="Fire and smoke damage public adjuster in FL and CA. We prove the true cost of structural and contents restoration and force your insurer to pay in full."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Fire Damage Public Adjuster",
        "provider": { "@type": "LocalBusiness", "name": "Claim Guardians LLC" },
        "areaServed": [{ "@type": "State", "name": "Florida" }, { "@type": "State", "name": "California" }],
        "description": "Fire and smoke damage public adjuster in FL and CA. We prove the true cost of structural and contents restoration."
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{
          "@type": "Question",
          "name": "Does homeowners insurance cover fire damage in Florida?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Standard homeowners insurance in Florida covers fire and smoke damage to the structure, personal property, and additional living expenses while your home is being repaired." }
        }, {
          "@type": "Question",
          "name": "How long does a fire damage insurance claim take?",
          "acceptedAnswer": { "@type": "Answer", "text": "Fire damage claims typically take 30 to 90 days to settle, depending on the severity of damage and how aggressively your insurer contests the claim. Claim Guardians accelerates the process by providing complete documentation upfront." }
        }, {
          "@type": "Question",
          "name": "What should I do immediately after a house fire?",
          "acceptedAnswer": { "@type": "Answer", "text": "Call 911, secure the property, and do not enter until the fire department clears it. Document damage with photos and video before cleanup begins. Then call Claim Guardians for a free inspection before your insurer sends their adjuster." }
        }, {
          "@type": "Question",
          "name": "Does insurance cover smoke damage without visible fire?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Smoke damage from a covered fire event is insured even when there is no direct flame contact. Soot particles permanently contaminate drywall, insulation, ductwork, and personal property. Insurers frequently undervalue smoke damage." }
        }, {
          "@type": "Question",
          "name": "How much does a fire damage public adjuster cost?",
          "acceptedAnswer": { "@type": "Answer", "text": "Claim Guardians charges zero upfront fees. We work on a contingency basis and only collect a percentage of your final settlement. If we don't increase your payout, you owe us nothing." }
        }]
      }
    </script>
  </Fragment>

  <!-- 1. Hero -->
  <header class="relative bg-[#041224] overflow-hidden" style="padding-top:8rem; padding-bottom:8rem;">
    <div class="absolute inset-0 z-0">
      <img src="/images/hero-fire-damage.png" alt="Fire and smoke damage to a Florida home" class="w-full h-full object-cover opacity-60 scale-105" fetchpriority="high" loading="eager"/>
      <div class="absolute inset-0 bg-gradient-to-b from-[#041224]/40 via-[#002D51]/20 to-[#041224]"></div>
    </div>
    <div class="section-inner relative z-10">
      <nav aria-label="Breadcrumb" class="mb-10 inline-flex">
        <ol class="flex items-center space-x-2 text-sm text-slate-400 font-medium bg-white/5 px-4 py-2 rounded-full border border-white/10">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li><a href="/services/" class="hover:text-white transition-colors">Services</a></li>
          <li><span class="mx-2 text-slate-600">›</span></li>
          <li class="text-white" aria-current="page">Fire Damage</li>
        </ol>
      </nav>
      <div class="max-w-4xl">
        <span class="eyebrow" style="color:#00B5A6;">Property Damage — Fire &amp; Smoke</span>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white mb-8 leading-[1.1] tracking-tight">
          Fire & Smoke Damage Public Adjuster - Get Your Full Settlement.
        </h1>
        <p class="text-xl text-slate-300 mb-12 leading-relaxed max-w-3xl">
          Fire damage destroys both structure and contents. Insurance companies undervalue smoke contamination and restoration costs. Claim Guardians documents the true cost and forces your insurer to pay in full.
        </p>
        <div class="flex flex-col sm:flex-row gap-5 mb-12">
          <a href="/free-claim-review/" class="btn-accent px-10 py-5 text-lg min-h-[60px]">Get a Free Fire Damage Inspection</a>
          <a href="tel:3058045489" class="inline-flex justify-center items-center px-10 py-5 text-lg font-bold text-white bg-white/5 border-2 border-white/20 rounded-xl hover:bg-white/10 transition-all transform hover:-translate-y-1 min-h-[60px]">Call a Fire Expert Now</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 grayscale opacity-60">
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">🏛️</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">DFS Licensed</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">🛡️</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">Policyholder Advocacy</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">⚖️</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">State Bonded</span>
        </div>
        <div class="flex flex-col items-center gap-2">
          <span class="text-2xl">💰</span>
          <span class="text-[10px] uppercase font-black tracking-widest text-slate-400">No-Fee Guarantee</span>
        </div>
      </div>
      </div>
    </div>
  </header>

  <!-- 2. Problem / Solution -->
  <section class="section-white">
    <div class="section-inner">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <span class="eyebrow">The Problem</span>
          <h2 class="section-heading mb-6">Insurers Undervalue Smoke Damage and Restoration Costs.</h2>
          <p class="text-lg text-slate-500 leading-relaxed">
            Fire doesn't have to destroy a room to render it uninhabitable. Toxic smoke and soot permeate walls, HVAC systems, and personal property. Insurance adjusters routinely minimize smoke damage to reduce your payout.
          </p>
        </div>
        <div class="card-hover p-10">
          <h3 class="text-2xl font-bold text-[#082142] mb-6 flex items-center gap-3">
            <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-[#002D51]/10 text-[#00808C]">✓</span>
            Claim Guardians Quantifies Every Loss.
          </h3>
          <ul class="space-y-5">
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">🔥</span><span class="text-lg font-medium text-[#082142]">We document structural char damage, beam compromise, and smoke infiltration.</span></li>
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">📦</span><span class="text-lg font-medium text-[#082142]">We inventory and value all damaged personal property and contents.</span></li>
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">⚖️</span><span class="text-lg font-medium text-[#082142]">We force your insurer to fund professional remediation and full restoration.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What Fire Insurance Covers -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Policy Education</span>
        <h2 class="section-heading">What Does Fire Insurance Cover?</h2>
        <p class="text-lg text-slate-500 max-w-3xl mx-auto mt-4">Your homeowners policy covers fire and smoke damage, but insurance companies routinely undervalue the scope of destruction. Here is what your policy actually protects.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card-hover group">
          <div class="text-4xl mb-4">🏗️</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Structural Damage</h3>
          <p class="text-slate-500">Fire compromises load-bearing walls, roof trusses, and framing. Your policy covers complete structural rebuilds when repair is not feasible. Insurers often push cheaper repairs instead of proper reconstruction.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">💨</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Smoke & Soot Contamination</h3>
          <p class="text-slate-500">Smoke particles penetrate drywall, insulation, ductwork, clothing, and electronics. Professional remediation or full replacement is required. Insurance adjusters routinely undercount contaminated items.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">📦</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Personal Property & Contents</h3>
          <p class="text-slate-500">Furniture, electronics, clothing, and valuables destroyed or contaminated by fire and smoke. Claim Guardians inventories every item at current replacement cost, not depreciated value.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🏠</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Additional Living Expenses</h3>
          <p class="text-slate-500">Your policy covers hotel stays, temporary housing, meals, and relocation costs while your property is uninhabitable. Many policyholders leave thousands of ALE dollars unclaimed.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Code Upgrade Coverage</h3>
          <p class="text-slate-500">When rebuilding, current building codes may require upgrades beyond the original construction. Your policy may cover these additional costs. Claim Guardians ensures code upgrade coverage is included in your settlement.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🌿</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Landscaping & Exterior</h3>
          <p class="text-slate-500">Trees, shrubs, fencing, detached structures (sheds, garages), and outdoor equipment damaged by fire. These losses are commonly overlooked in initial claims.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Our Claims Process -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">How It Works</span>
        <h2 class="section-heading">Our Fire Damage Claims Process</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="step-number mx-auto">1</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Emergency Inspection</h3>
          <p class="text-slate-500">We inspect your property as soon as the fire department clears it. We document structural char, smoke infiltration, and contents damage before cleanup begins.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">2</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Contents Inventory</h3>
          <p class="text-slate-500">We create a room-by-room inventory of every destroyed or contaminated item at current replacement cost. This detailed list prevents your insurer from undervaluing your personal property.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">3</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Claim Filing & Negotiation</h3>
          <p class="text-slate-500">We prepare a complete scope of loss covering structure, contents, ALE, and code upgrades. We submit directly to your insurer and handle all back-and-forth negotiation.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">4</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Full Settlement</h3>
          <p class="text-slate-500">We force your insurer to pay the true cost of restoration. If they lowball, we escalate through the appraisal process or refer you to a property damage attorney.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Result Proof -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Proven Results</span>
        <h2 class="section-heading">We Recover the Full Cost of Your Fire Loss.</h2>
      </div>
      <div class="max-w-3xl mx-auto card-testimonial">
        <span class="inline-flex px-4 py-2 bg-blue-50 text-[#002D51] text-sm font-bold rounded-full mb-8 border border-blue-100">📍 Kitchen Fire &amp; Smoke Damage, Orlando, FL.</span>
        <div class="space-y-6 mb-8 pb-8 border-b border-slate-100">
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-2">
            <span class="text-slate-500 font-medium text-sm uppercase">Insurance Initial Offer</span>
            <span class="text-red-400 line-through font-bold text-2xl">$22,000</span>
          </div>
          <div class="h-px bg-slate-100"></div>
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
            <span class="text-[#082142] font-bold text-sm uppercase">Claim Guardians Settlement</span>
            <span class="text-green-600 font-black text-4xl tracking-tighter">$94,500</span>
          </div>
        </div>
        <div class="bg-slate-50 -mx-10 -mb-10 p-10 rounded-b-3xl">
          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Action Taken</h4>
          <p class="text-xl font-medium text-[#082142] leading-relaxed">We documented HVAC smoke contamination and full contents loss the insurer's adjuster omitted. Settlement funded a complete home restoration.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="eyebrow">Common Questions</span>
        <h2 class="section-heading">Frequently Asked Questions About Fire Damage Claims</h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>Does homeowners insurance cover fire damage in Florida?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Yes. Standard homeowners insurance in Florida covers fire and smoke damage to the structure, personal property, and additional living expenses while your home is being repaired. Claim Guardians ensures every applicable coverage is included in your settlement.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How long does a fire damage insurance claim take?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Fire damage claims typically take 30 to 90 days to settle, depending on the severity of damage and how aggressively your insurer contests the claim. Claim Guardians accelerates the process by providing complete documentation upfront, reducing back-and-forth delays.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>What should I do immediately after a house fire?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Call 911 first, then secure your property. Do not re-enter until the fire department clears the building. Document all visible damage with photos and video before any cleanup begins. Contact Claim Guardians before your insurance company sends their adjuster so we can protect your interests from the start.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>Does insurance cover smoke damage without visible fire?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Yes. Smoke damage from a covered fire event is insured even when there is no direct flame contact. Toxic soot particles permanently contaminate drywall, insulation, ductwork, clothing, and electronics. Insurance adjusters routinely undervalue smoke contamination. Claim Guardians hires industrial hygienists to prove the full extent of contamination.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How much does a fire damage public adjuster cost?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Claim Guardians charges zero upfront fees. We work on a contingency basis and only collect a percentage of your final settlement. If we don't increase your payout, you owe us nothing.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-12">
        <span class="eyebrow">Related Services</span>
        <h2 class="section-heading">Fire Damage Often Causes Secondary Damage</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/water-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Water Damage Claims</h3>
          <p class="text-slate-500">Fire suppression water and broken pipes cause extensive secondary damage. We recover these costs too.</p>
        </a>
        <a href="/services/mold-claims/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Mold Damage Claims</h3>
          <p class="text-slate-500">Water used to fight fires creates mold growth within 48 hours. We prove the connection to your covered event.</p>
        </a>
        <a href="/services/denied-claims/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Denied Claim Appeals</h3>
          <p class="text-slate-500">If your fire claim was denied or underpaid, we appeal and force the insurer to pay.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="gradient-accent-bar section-white text-center">
    <div class="section-inner">
      <span class="eyebrow">No-Risk Consultation</span>
      <h2 class="section-heading mb-4">Did Fire or Smoke Damage Your Property?</h2>
      <p class="text-xl text-slate-500 mb-8 max-w-2xl mx-auto">Get the full settlement you deserve, not what the insurance company is willing to offer.</p>
      <a href="/free-claim-review/" class="btn-accent px-12 py-5 text-xl min-h-[64px]">Start Free Fire Claim Review →</a>
      <p class="text-sm text-slate-400 mt-4">Zero upfront cost. Ever.</p>
      
      <div class="mt-24 max-w-xl mx-auto">
        <EligibilityTest client:visible />
      </div>
    </div>
  </section>

  <div class="fixed bottom-0 left-0 right-0 p-4 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] z-50 sm:hidden">
    <a href="tel:3058045489" class="btn-accent w-full text-lg">🚨 Emergency? Call Now</a>
  </div>
</BaseLayout>
