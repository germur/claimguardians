---
import PageHero from "../../components/PageHero.astro";
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimCalculator from '../../components/ClaimCalculator';
import EligibilityTest from '../../components/EligibilityTest';
---

<BaseLayout 
  title="Mold Damage Insurance Claim Florida - Remediation Coverage | Claim Guardians"
  description="Mold damage insurance claim help in Florida. We prove the link to covered water damage and force your insurer to fund complete mold remediation."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Mold Damage Insurance Claim Help",
        "provider": { "@id": "https://allclaimguardians.com/#organization" },
        "areaServed": [{ "@type": "State", "name": "Florida" }, { "@type": "State", "name": "California" }, { "@type": "State", "name": "North Carolina" }],
        "description": "Mold damage insurance claim help in Florida. We prove the link to covered water damage and force your insurer to fund complete mold remediation."
      }
    </script>
  </Fragment>

  <!-- 1. Hero -->
  <PageHero title={"Mold damage claim help."} eyebrow={"Property claims / Moisture & mold"} description={"Bring the policy, moisture records and any professional assessments. We discuss how the reported damage relates to the claim and what documentation may be needed."} image={"/images/hero-mold-damage.png"} current={"Mold damage"} parent={{"label":"Services","href":"/services/"}}></PageHero>

  <!-- 2. Urgency Alert -->
  <section class="section-dark text-center">
    <div class="section-inner">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-500/10 border border-red-500/20 text-4xl mb-8">🦠</div>
      <h2 class="section-heading-light mb-6 md:text-5xl">Florida Mold Grows Fast. <span class="text-red-400">Act Within 48 Hours.</span></h2>
      <p class="text-xl text-slate-300 leading-relaxed mb-10 max-w-2xl mx-auto">
        Florida's heat and humidity create ideal conditions for toxic black mold. Every day of delay increases remediation costs and risks to your family's health. Claim Guardians dispatches an inspector immediately.
      </p>
      <a href="tel:3058045489" class="btn-accent px-12 py-5 text-xl min-h-[64px]">Request Emergency Mold Assessment</a>
    </div>
  </section>

  <!-- 3. Problem / Solution -->
  <section class="section-white">
    <div class="section-inner">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <span class="eyebrow">The Problem</span>
          <h2 class="section-heading mb-6">Insurers Deny Mold Claims as "Maintenance Failures."</h2>
          <p class="text-lg text-slate-500 leading-relaxed">
            When you file a mold claim, insurance adjusters argue the mold developed over time from poor maintenance — not from your covered water event. This strategy lets them deny valid claims. Claim Guardians connects the forensic dots.
          </p>
        </div>
        <div class="card-hover p-10">
          <h3 class="text-2xl font-bold text-[#082142] mb-6 flex items-center gap-3">
            <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center rounded-full bg-[#002D51]/10 text-[#00808C]">✓</span>
            Claim Guardians Traces Mold to Its Source.
          </h3>
          <ul class="space-y-5">
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">🔬</span><span class="text-lg font-medium text-[#082142]">We commission certified industrial hygienist mold reports.</span></li>
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">📸</span><span class="text-lg font-medium text-[#082142]">We document the direct causal chain from water event to mold growth.</span></li>
            <li class="flex items-start gap-4"><span class="text-[#00808C] mt-1">⚖️</span><span class="text-lg font-medium text-[#082142]">We force your insurer to fund complete remediation and rebuild.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- What Mold Insurance Covers -->
  <section class="section-muted">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">Policy Education</span>
        <h2 class="section-heading">What Does Mold Insurance Cover in Florida?</h2>
        <p class="text-lg text-slate-500 max-w-3xl mx-auto mt-4">Florida mold coverage depends on how the mold started. If it resulted from a covered water event, your insurer must pay. Here is what your policy protects.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card-hover group">
          <div class="text-4xl mb-4">🔬</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Mold Testing & Assessment</h3>
          <p class="text-slate-500">Air quality testing, surface sampling, and industrial hygienist reports to identify mold species and contamination levels. These costs are covered when connected to a water claim.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🏗️</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Structural Remediation</h3>
          <p class="text-slate-500">Removal and replacement of mold-contaminated drywall, insulation, framing, and flooring. Your policy covers tearing out and rebuilding affected areas to eliminate mold at the source.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">💨</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">HVAC Decontamination</h3>
          <p class="text-slate-500">Mold spores spread through your air conditioning system. Professional duct cleaning or HVAC replacement is covered when mold contamination is documented in the system.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">📦</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Contents & Personal Property</h3>
          <p class="text-slate-500">Furniture, clothing, and personal items contaminated by mold. Porous materials that cannot be decontaminated must be replaced at current cost. Insurers routinely undercount these losses.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🏠</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Additional Living Expenses</h3>
          <p class="text-slate-500">If mold makes your home uninhabitable during remediation, your policy covers temporary housing, meals, and relocation costs. Many homeowners don't know this coverage exists.</p>
        </div>
        <div class="card-hover group">
          <div class="text-4xl mb-4">🔁</div>
          <h3 class="text-xl font-bold text-[#082142] mb-3 group-hover:text-[#00808C] transition-colors">Post-Remediation Testing</h3>
          <p class="text-slate-500">Clearance testing after remediation confirms mold levels are safe. This step is required before reconstruction begins and should be covered under your claim.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Claims Process -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-16">
        <span class="eyebrow">How It Works</span>
        <h2 class="section-heading">Our Mold Damage Claims Process</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="step-number mx-auto">1</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Free Mold Assessment</h3>
          <p class="text-slate-500">We inspect your property for visible mold and moisture sources. We identify the water event that caused the growth and determine if your claim qualifies for coverage.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">2</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Hygienist Report</h3>
          <p class="text-slate-500">We commission a certified industrial hygienist to perform air quality testing and surface sampling. This independent report proves the extent of contamination and the causal chain from water to mold.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">3</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Claim Filing</h3>
          <p class="text-slate-500">We prepare a complete scope of loss covering remediation, structural repair, contents replacement, and ALE costs. We submit directly to your insurer with all supporting evidence.</p>
        </div>
        <div class="text-center">
          <div class="step-number mx-auto">4</div>
          <h3 class="text-xl font-bold text-[#082142] mt-6 mb-3">Full Remediation Coverage</h3>
          <p class="text-slate-500">We negotiate for complete mold remediation funding. If your insurer tries to cap coverage or deny the claim, we escalate through appraisal or connect you with a property attorney.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="section-muted">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="eyebrow">Common Questions</span>
        <h2 class="section-heading">Frequently Asked Questions About Mold Damage Claims</h2>
      </div>
      <div class="space-y-4">
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>Does homeowners insurance cover mold in Florida?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Florida homeowners insurance covers mold damage when it results from a covered water event like a burst pipe, appliance malfunction, or storm damage. However, most policies cap mold coverage at $10,000 to $50,000. Claim Guardians proves the water source to unlock full coverage beyond those caps.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How do insurance companies deny mold claims?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Insurers claim mold is a maintenance issue, a pre-existing condition, or that it developed gradually rather than from a sudden water event. They use these arguments to trigger policy exclusions. Claim Guardians hires industrial hygienists to prove the direct causal chain from your covered water event to the mold growth.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How much does mold remediation cost in Florida?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Professional mold remediation in Florida typically costs $2,000 to $30,000 depending on the extent of contamination. Large-scale remediation involving structural repairs can exceed $50,000. Claim Guardians ensures your insurance settlement covers the full cost of professional remediation, not just surface cleaning.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>Can I stay in my home during mold remediation?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            It depends on the extent and location of the mold. If contamination is widespread or affects HVAC systems, you should relocate temporarily for health and safety reasons. Your homeowners policy covers additional living expenses during remediation. Claim Guardians includes ALE costs in every mold claim we file.
          </div>
        </details>
        <details class="group bg-white border border-slate-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-6 text-xl text-[#082142] group-hover:text-[#00808C] transition-colors">
            <span>How fast does mold grow after water damage in Florida?</span>
            <span class="transition group-open:rotate-180"><svg fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg></span>
          </summary>
          <div class="text-slate-600 px-6 pb-6 text-lg leading-relaxed border-t border-slate-100 pt-4">
            Mold can begin growing within 24 to 48 hours of water exposure in Florida's humid subtropical climate. Visible colonies can appear within 3 to 7 days. This is why immediate response to water damage is critical. Call Claim Guardians the same day you discover water intrusion.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="section-white">
    <div class="section-inner">
      <div class="text-center mb-12">
        <span class="eyebrow">Related Services</span>
        <h2 class="section-heading">Mold Damage is Always Connected to Water</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="/services/water-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Water Damage Claims</h3>
          <p class="text-slate-500">The root cause of mold. We document the original water event that triggered mold growth.</p>
        </a>
        <a href="/services/roof-damage/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Roof Damage Claims</h3>
          <p class="text-slate-500">Roof leaks are one of the most common sources of mold in Florida homes.</p>
        </a>
        <a href="/services/denied-claims/" class="card-hover group block">
          <h3 class="text-xl font-bold text-[#082142] mb-2 group-hover:text-[#00808C] transition-colors">Denied Claim Appeals</h3>
          <p class="text-slate-500">If your mold claim was denied, we appeal with forensic evidence and force the insurer to pay.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Claim Value Calculator (BOFU Island) -->
  <section class="section-muted overflow-hidden">
    <div class="section-inner text-center">
      <div class="max-w-3xl mx-auto mb-12">
        <span class="eyebrow">Mold Remediation Value</span>
        <h2 class="section-heading">Prepare for your claim review.</h2>
      </div>
      <ClaimCalculator client:visible />
    </div>
  </section>


  <!-- 4. Final CTA -->
  <section class="gradient-accent-bar section-white text-center">
    <div class="section-inner">
      <span class="eyebrow">Qualify Your Claim</span>
      <h2 class="section-heading mb-4">You May Qualify for Complete Re-Evaluation.</h2>
      <EligibilityTest client:visible />
    </div>
  </section>


  <div class="fixed bottom-0 left-0 right-0 p-4 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-[0_-10px_40px_rgba(0,0,0,0.1)] z-50 sm:hidden">
    <a href="tel:3058045489" class="btn-accent w-full text-lg">🚨 Emergency? Call Now</a>
  </div>

  <section class="section-muted">
    <div class="section-inner max-w-4xl">
      <h2 class="section-heading mb-4">What should you bring to a claim review?</h2>
      <p class="text-lg text-slate-700 leading-relaxed mb-5">Bring your policy, dated photos, repair estimates or reports, and any insurer letters. If the claim was denied or paid, include the decision and a timeline of communication. The review considers your policy and documented damage; it does not guarantee coverage or a particular settlement.</p>
      <div class="flex flex-wrap gap-5"><a class="text-[#006775] font-bold underline" href="/resources/claim-review-guide/">Read the claim review guide</a><a class="text-[#006775] font-bold underline" lang="es" href="/es/guia-reclamacion/">Guía de reclamaciones en español</a></div>
    </div>
  </section>
</BaseLayout>
