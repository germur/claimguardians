---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceDirectory from '../../components/ServiceDirectory.astro';
import EligibilityTest from '../../components/EligibilityTest';


---

<BaseLayout 
  title="Property Damage Public Adjuster Services in FL, CA & NC | Claim Guardians"
  description="Licensed public adjuster services across Florida, California & North Carolina. Hurricane, water, roof, fire, mold, and denied claims maximized. No fee until you get paid."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "serviceType": "Public Adjusting Services",
        "provider": { "@id": "https://allclaimguardians.com/#organization" },
        "url": "https://allclaimguardians.com/services/",
        "areaServed": [
          { "@type": "State", "name": "Florida" },
          { "@type": "State", "name": "California" },
          { "@type": "State", "name": "North Carolina" }
        ],
        "description": "Public adjusting services for residential and commercial property claims in Florida, California and North Carolina.",
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Property Claim Adjusting Services",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Hurricane Damage Claims"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Water Damage Claims"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Roof Damage Claims"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Fire & Smoke Damage Claims"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Mold Remediation Claims"
              }
            },
            {
              "@type": "Offer",
              "itemOffered": {
                "@type": "Service",
                "name": "Denied Claim Appeals"
              }
            }
          ]
        }
      }
    </script>
  </Fragment>

  <PageHero title="Property damage." emphasis="Personal advocacy." eyebrow="Public adjusting services / Florida, California & North Carolina" description="Choose the help that fits your property loss. We document damage, review the policy and communicate with the insurer on the policyholder’s behalf." image="/images/florida-damaged-house-hero.png" current="Services" ctaHref="#service-review" ctaLabel="Find help with your claim" />
  <ServiceDirectory />
  <section class="service-review-section" id="service-review"><div class="design-shell service-review-layout"><div><p class="design-kicker">Not sure where to start?</p><h2>A few questions.<br /><em>A clearer direction.</em></h2><p>Tell us where the claim stands and what damage occurred. You can request an initial conversation without uploading policy documents.</p><a class="design-text-link" href="/resources/claim-review-guide/">What to prepare for a review ↗</a></div><EligibilityTest client:visible /></div></section>
  <section class="section-white"><div class="section-inner"><p class="eyebrow">Where we work</p><h2 class="section-heading mb-5">Property claim help across three states.</h2><div class="flex flex-wrap gap-5"><a class="design-text-link" href="/service-areas/">Florida & California ↗</a><a class="design-text-link" href="/service-areas/north-carolina/">North Carolina ↗</a><a class="design-text-link" href="/company/">Team & credentials ↗</a></div></div></section>
</BaseLayout>
