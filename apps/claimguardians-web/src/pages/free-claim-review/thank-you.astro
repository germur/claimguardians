---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout noindex title="Thank You | Claim Guardians" description="Next steps after requesting a property insurance claim review.">
  <section class="section-white">
    <div class="section-inner max-w-2xl text-center">
      <span class="eyebrow">Your next step</span>
      <h1 class="text-3xl md:text-5xl font-bold mb-6">Thank you for your request.</h1>
      <p class="text-lg text-slate-700 mb-6">Our team will review the details you provided and contact you about your property claim. Keep your policy, photos, and any letters from your insurer available for the conversation.</p>
      <p class="text-slate-600 mb-8">For urgent assistance, call <a href="tel:+13058045489" class="font-bold underline text-[#006775]">(305) 804-5489</a>. Se habla español.</p>
      <a class="btn-accent" href="/">Return to homepage</a>
      <a class="block mt-6 underline text-[#006775]" href="/resources/#claim-guide">See how to prepare for your review</a>
    </div>
  </section>
</BaseLayout>
