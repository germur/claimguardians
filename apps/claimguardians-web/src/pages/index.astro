---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClaimCalculator from '../components/ClaimCalculator';
import Icon from '../components/DesignIcon.astro';
const services = [
  { name: 'Water & leaks', slug: 'water-damage', icon: 'water', description: 'From the first signs of moisture to the damage behind the walls.', image: 'hero-water-damage.png' },
  { name: 'Hurricane & storm', slug: 'hurricane-damage', icon: 'wind', description: 'Wind, hail and storm damage. Documented with your claim in mind.', image: 'hero-hurricane-damage.png' },
  { name: 'Roof damage', slug: 'roof-damage', icon: 'roof', description: 'Understand the inspection, repair scope and insurer’s response.' },
  { name: 'Fire & smoke', slug: 'fire-damage', icon: 'fire', description: 'A careful review of structural damage, smoke and affected belongings.' },
  { name: 'Mold damage', slug: 'mold-claims', icon: 'mold', description: 'Connect the damage records, assessments and policy questions.' },
  { name: 'Denied or underpaid', slug: 'denied-claims', icon: 'denied', description: 'Get a second look at the written decision and supporting evidence.' },
];
const faq = [
  { q: 'What does a public adjuster do?', a: 'A public adjuster represents the policyholder within an agreed scope: reviewing the policy, documenting the property loss, preparing the claim and communicating with the insurer.' },
  { q: 'How much does the initial review cost?', a: 'The initial claim review is free. Any representation requires a separate written agreement explaining scope, fees, expenses and cancellation terms before you sign.' },
  { q: 'Can you review a denied or underpaid claim?', a: 'Yes. We can discuss the written decision and available records. Further options depend on the policy, evidence, claim history and applicable deadlines; a review does not guarantee additional payment.' },
  { q: 'Can I speak with someone in Spanish?', a: 'Yes. Choose Español as your preferred language on the request form. We discuss residential and commercial property claims in English and Spanish.' },
];
---
<BaseLayout title="Public Adjusters in FL, CA & NC | Claim Guardians" description="Property damage claim support in Florida, California, and North Carolina. We inspect damage, document your loss, and negotiate with your insurer. Request a free review.">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) })} /></Fragment>
  <div class="design-page">
    <section class="editorial-hero design-shell" aria-labelledby="home-heading">
      <div class="hero-copy">
        <p class="design-kicker"><span class="status-dot"></span> Property insurance. Policyholder advocacy.</p>
        <h1 id="home-heading">Public adjusters.<br />On <em>your</em> side.</h1>
        <p class="hero-deck">Property damage is enough to deal with.<br class="desktop-break" /> You don’t have to navigate the claim alone.</p>
        <p class="hero-description">We document your loss, review your policy and negotiate with your insurer. For homeowners and businesses in Florida, California and North Carolina.</p>
        <div class="design-actions"><a class="design-button" href="/free-claim-review/">Get a free claim review <Icon /></a><a class="design-text-link" href="tel:3058045489">(305) 804-5489 <span aria-hidden="true">↗</span></a></div>
        <div class="hero-footnote"><Icon name="shield" size={19} /><span>Your property. Your claim. Your advocate.</span></div>
      </div>
      <div class="hero-visual">
        <img src="/images/florida-damaged-house-hero.png" alt="Illustration of a coastal home after storm damage" width="640" height="640" fetchpriority="high" />
        <span class="photo-label">AFTER THE DAMAGE.<br />BEFORE THE NEXT CHAPTER.</span>
        <div class="hero-visual-note"><span class="note-marker" aria-hidden="true">↗</span><div><span class="design-kicker">A clearer next step</span><p>Start with a conversation.<br />We’ll help you understand the claim.</p></div></div>
      </div>
    </section>
    <div class="coverage-ribbon"><div class="design-shell"><span>Advocacy across</span><a href="/service-areas/">Florida <span aria-hidden="true">↗</span></a><a href="/service-areas/">California <span aria-hidden="true">↗</span></a><a href="/service-areas/north-carolina/">North Carolina <span aria-hidden="true">↗</span></a><span class="ribbon-language">English / Español</span></div></div>
    <section class="design-section design-shell" aria-labelledby="damage-heading">
      <div class="design-section-head"><div><p class="design-kicker">01 / Find your starting point</p><h2 id="damage-heading">Different damage.<br /><em>The same commitment.</em></h2></div><p>Find the help that fits your property claim. New, denied or partially paid.</p></div>
      <div class="service-mosaic">{services.map((service, i) => <a class:list={['design-service', { 'design-service-photo': !!service.image }]} href={`/services/${service.slug}/`}>
        {service.image && <img src={`/images/${service.image}`} alt="" width="640" height="640" loading="lazy" />}
        <div class="service-topline"><Icon name={service.icon} size={28} /><span>0{i + 1}</span></div>
        <div class="service-bottom"><h3>{service.name}</h3><p>{service.description}</p><span class="service-explore">Explore this service <Icon size={20} /></span></div>
      </a>)}</div>
    </section>
    <section class="advocacy-section"><div class="design-shell advocacy-layout"><div><p class="design-kicker">02 / The people on your side</p><h2>An insurer has an adjuster.<br /><em>You can have one, too.</em></h2><a class="design-text-link" href="/company/">Meet Claim Guardians <Icon size={20} /></a></div><div class="advocacy-detail"><p class="large-detail">We work for the property owner.</p><p>Our role is to make the loss clear: what happened, what the records show and what needs to be discussed with the insurer.</p><ul><li><span>01</span> Documentation built around your property</li><li><span>02</span> Communication through the claim process</li><li><span>03</span> Scope and fees explained before representation</li></ul><a href="/company/" class="design-text-link">Check professional credentials <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="design-section design-shell"><div class="design-section-head"><div><p class="design-kicker">03 / What happens next</p><h2>Less uncertainty.<br /><em>A clear way forward.</em></h2></div><p>Start with the details you have. We’ll discuss the next step together.</p></div><ol class="design-process"><li><span>01 / Let’s talk</span><h3>Tell us what happened.</h3><p>Share the property location, damage and where the claim stands. The initial review is free.</p></li><li><span>02 / Build the picture</span><h3>Review the records.</h3><p>We discuss the policy, photographs and insurer correspondence, and whether an inspection is appropriate.</p></li><li><span>03 / Decide together</span><h3>Know your next step.</h3><p>Ask questions, check credentials and review the written terms before any representation begins.</p></li></ol></section>
    <section class="preparation-section"><div class="design-shell preparation-layout"><div><p class="design-kicker">A little preparation. More clarity.</p><h2>What should<br /><em>you keep handy?</em></h2><p>Choose the type of damage to see which records may help. You can request a conversation before you have everything ready.</p><a class="design-text-link" href="/resources/claim-review-guide/">Read the property claim guide <Icon size={20} /></a><a class="design-text-link" href="/es/guia-reclamacion/">Guía en español <span aria-hidden="true">↗</span></a></div><ClaimCalculator client:visible /></div></section>
    <section class="design-section design-shell design-faq-layout"><div><p class="design-kicker">Before we speak</p><h2>Good questions.<br /><em>Straight answers.</em></h2><a class="design-text-link" href="/resources/">More questions & resources <Icon size={20} /></a></div><div class="design-faq">{faq.map(item => <details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></section>
    <section class="design-shell design-closing"><div><p class="design-kicker">Your next chapter starts here</p><h2>Let’s make sense<br /><em>of your claim.</em></h2></div><div><a class="design-button" href="/free-claim-review/">Request a free review <Icon /></a><p>Homeowners & businesses · English & Spanish</p></div></section>
  </div>
</BaseLayout>
