---
import PageHero from "../components/PageHero.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm';
---

<BaseLayout 
  title="Free Claim Review | NC, FL & CA Public Adjuster | Claim Guardians"
  description="Request a free initial property insurance claim review. Tell us about the damage, property and how to contact you in three short steps."
>
  <Fragment slot="head">
    <script type="application/ld+json">{"@context": "https://schema.org", "@type": "ContactPage", "name": "Claim Guardians Free Claim Review", "description": "Free property damage assessment and insurance claim review in North Carolina, Florida, and California.", "url": "https://allclaimguardians.com/free-claim-review/", "mainEntity": {"@id": "https://allclaimguardians.com/#organization"}}</script>
  </Fragment>

  <PageHero title="Free property claim review." emphasis="Start with what you know." eyebrow="Your damage / Your property / Your next step" description="Three short steps help us understand your situation. Share only the details requested; keep private policy documents and claim records for the follow-up conversation." current="Free claim review" ctaLabel="" />
  <section class="claim-review-section design-shell"><div class="claim-review-form"><LeadForm client:load /></div><aside class="claim-review-aside"><p class="design-kicker">A clear first step</p><h2>Tell us the basics.<br /><em>We’ll take it from there.</em></h2><ol><li><span>01</span><div><h3>The initial review is free.</h3><p>Submitting this form requests a conversation. It does not sign you up for representation.</p></div></li><li><span>02</span><div><h3>Your choice of language.</h3><p>Choose English or Español for the follow-up conversation.</p></div></li><li><span>03</span><div><h3>Clear terms before you commit.</h3><p>Any representation needs a separate written agreement explaining scope, fees, expenses and cancellation terms.</p></div></li></ol><div class="review-contact-note"><p>Prefer to talk?</p><a href="tel:3058045489">(305) 804-5489 ↗</a><a class="design-text-link" href="/contact/">Use the contact form instead ↗</a></div></aside></section>
  <section class="section-muted"><div class="section-inner review-after"><div><p class="eyebrow">After you send your request</p><h2 class="section-heading">A conversation.<br />Then a decision.</h2></div><div><p>We review the details you provided and discuss your property, damage records and claim situation. If appropriate, we confirm inspection availability and what further information would help.</p><p>Keep the policy, dated photographs, estimates and insurer letters available. The initial review does not guarantee coverage, reopening or additional payment.</p><a class="design-text-link" href="/resources/claim-review-guide/">Prepare for your review ↗</a></div></div></section>
</BaseLayout>
