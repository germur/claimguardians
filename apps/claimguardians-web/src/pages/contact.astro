---
import PageHero from "../components/PageHero.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadCaptureForm from '../components/LeadCaptureForm';
---

<BaseLayout 
  title="Contact a Public Adjuster - Free Consultation FL, CA & NC | Claim Guardians"
  description="Contact Claim Guardians about a property insurance claim in Florida, California or North Carolina. Request a free initial review in English or Spanish."
>
  <Fragment slot="head">
    <script type="application/ld+json">{"@context": "https://schema.org", "@type": "ContactPage", "mainEntity": {"@id": "https://allclaimguardians.com/#organization"}, "url": "https://allclaimguardians.com/contact/"}</script>
  </Fragment>

  <PageHero title="Let’s talk about" emphasis="your property claim." eyebrow="A conversation is a good place to start" description="Tell us what happened, where the property is and where the claim stands. Request a conversation in English or Spanish, or contact the team directly." current="Contact" ctaHref="#contact-message" ctaLabel="Send us a message" />
  <section class="contact-section design-shell"><div class="contact-details"><p class="design-kicker">Direct contact</p><h2>Real questions.<br /><em>Let’s talk them through.</em></h2><p>You don’t need every document ready to ask for help. Choose the contact method that works for you.</p><div class="contact-channel"><span>01 / Call the team</span><a href="tel:3058045489">(305) 804-5489 ↗</a></div><div class="contact-channel"><span>02 / Write to us</span><a href="mailto:home@allclaimguardians.com">home@allclaimguardians.com ↗</a></div><div class="contact-channel"><span>03 / Headquarters</span><p>304 Indian Trace Unit 655<br />Weston, FL 33326</p></div><p class="contact-note">Property claim services in Florida, California and North Carolina. <a href="/service-areas/">Explore service areas ↗</a></p></div><div class="contact-form-panel" id="contact-message"><p class="design-kicker">Request a conversation</p><h2>Send us a message.</h2><p>Tell us how to reach you and briefly describe the property damage. Keep private claim documents for the follow-up.</p><LeadCaptureForm client:load leadType="contact" /></div></section>
</BaseLayout>
