---
import '../styles/global.css';
import '../styles/editorial.css';
import EntitySchema from '../components/EntitySchema.astro';
import Attribution from '../components/Attribution.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  lang?: 'en' | 'es';
  guideAlternates?: boolean;
}

const { title, description, image = '/images/florida-damaged-house-hero.png', noindex = false, lang = 'en', guideAlternates = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-R0GH89D0MF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-R0GH89D0MF');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {guideAlternates && <>
      <link rel="alternate" hreflang="en-US" href="https://allclaimguardians.com/resources/claim-review-guide/" />
      <link rel="alternate" hreflang="es-US" href="https://allclaimguardians.com/es/guia-reclamacion/" />
      <link rel="alternate" hreflang="x-default" href="https://allclaimguardians.com/resources/claim-review-guide/" />
    </>}
    
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Claim Guardians" />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <EntitySchema />
    <slot name="head" />
  </head>
  <body class="bg-base-bg text-text-main font-sans antialiased min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <!-- 1. Global Header (Premium 2026 White Glassmorphism) -->
    <header class="site-header sticky top-0 z-50 backdrop-blur-2xl">
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#00808C]/5 to-transparent pointer-events-none"></div>
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex justify-between items-center relative z-10">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 font-extrabold text-2xl text-white tracking-tight group">
          <img src="/images/logo SVG.svg" alt="Claim Guardians Logo" class="h-12 w-auto transition-all duration-300 group-hover:scale-105" />
        </a>
        
        <!-- Desktop Links -->
        <div class="hidden md:flex items-center space-x-1">
          <a href="/services/" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-[#00808C] hover:bg-slate-50 rounded-lg transition-all duration-200">Services</a>
          <a href="/service-areas/" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-[#00808C] hover:bg-slate-50 rounded-lg transition-all duration-200">Areas We Serve</a>
          <a href="/resources/" class="px-4 py-2 text-sm font-bold text-slate-600 hover:text-[#00808C] hover:bg-slate-50 rounded-lg transition-all duration-200">Resources & FAQ</a>
          <a href="/company/" class="px-4 py-2 text-sm font-bold text-[#00808C] hover:text-[#00B5A6] hover:bg-slate-50 rounded-lg transition-all duration-200">Our Firm</a>
        </div>

        <!-- CTA Button & Mobile Toggle -->
        <div class="flex items-center gap-4">
          <a href="tel:3058045489" class="hidden lg:flex items-center gap-2 text-sm font-black text-[#002D51] hover:text-[#00808C] transition-colors mr-2">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00B5A6] opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-[#00B5A6]"></span>
            </span>
            (305) 804-5489
          </a>
          <a href="/free-claim-review/" class="hidden md:inline-flex justify-center items-center px-6 py-2.5 text-sm font-black text-white bg-[#00808C] rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-0.5 relative overflow-hidden group">
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-[100%] group-hover:animate-[shimmer_1.5s_infinite]"></span>
            <span class="relative">Free Claim Review</span>
          </a>
          
          <!-- Mobile Menu Button -->
          <button type="button" aria-label="Open navigation menu" aria-controls="mobile-menu" aria-expanded="false" id="mobile-menu-open" class="md:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg transition-colors focus:outline-none focus:ring-2 focus:ring-[#00B5A6]">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- Mobile Menu Overlay (Hidden by default) -->
    <dialog id="mobile-menu" aria-label="Site navigation" class="fixed inset-0 z-[100] m-0 h-[100dvh] max-h-none w-full max-w-none border-0 bg-transparent p-0 text-slate-900">
      <!-- Backdrop -->
      <div id="mobile-menu-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"></div>
      
      <!-- Menu Content -->
      <div id="mobile-menu-content" class="absolute right-0 top-0 bottom-0 w-full max-w-sm bg-white shadow-2xl flex flex-col">
        <div class="p-6 flex items-center justify-between border-b border-slate-100">
          <img src="/images/logo SVG.svg" alt="Claim Guardians Logo" class="h-8 w-auto" />
          <button type="button" aria-label="Close navigation menu" id="mobile-menu-close" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        
        <nav class="flex-grow p-8 space-y-6 overflow-y-auto">
          <a href="/services/" class="block text-xl font-bold text-slate-800 hover:text-[#00808C] transition-colors">Services</a>
          <a href="/service-areas/" class="block text-xl font-bold text-slate-800 hover:text-[#00808C] transition-colors">Areas We Serve</a>
          <a href="/resources/" class="block text-xl font-bold text-slate-800 hover:text-[#00808C] transition-colors">Resources & FAQ</a>
          <a href="/company/" class="block text-xl font-bold text-[#00808C] hover:text-[#00B5A6] transition-colors">Our Firm</a>
          
          <div class="pt-8 border-t border-slate-100 italic text-slate-500 text-sm">
            Property insurance advocates working exclusively for the policyholder.
          </div>
        </nav>
        
        <div class="p-6 bg-slate-50 border-t border-slate-100">
          <a href="/free-claim-review/" class="w-full flex justify-center items-center px-6 py-4 text-base font-black text-white bg-[#00808C] rounded-xl shadow-lg hover:bg-[#00B5A6] transition-all duration-300">
            Free Claim Review
          </a>
          <a href="tel:3058045489" class="mt-4 w-full flex justify-center items-center gap-2 text-base font-bold text-[#002D51] py-2">
            📞 (305) 804-5489
          </a>
        </div>
      </div>
    </dialog>
    
    <main id="main-content" tabindex="-1" class="flex-grow">
      <slot />
    </main>

    <!-- 8. Premium Mega Footer -->
    <SiteFooter />

    <script>
      const openBtn = document.getElementById('mobile-menu-open');
      const closeBtn = document.getElementById('mobile-menu-close');
      const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
      const backdrop = document.getElementById('mobile-menu-backdrop');
      let previousOverflow = '';
      function openMenu() {
        if (!menu || menu.open) return;
        previousOverflow = document.body.style.overflow;
        menu.showModal();
        document.body.style.overflow = 'hidden';
        openBtn?.setAttribute('aria-expanded', 'true');
        closeBtn?.focus();
      }
      function closeMenu() {
        if (!menu?.open) return;
        menu.close();
      }
      menu?.addEventListener('keydown', event => {
        if (event.key !== 'Tab') return;
        const controls = Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), select, textarea, [tabindex="0"]')).filter(element => element.getClientRects().length > 0);
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      });
      menu?.addEventListener('close', () => {
        document.body.style.overflow = previousOverflow;
        openBtn?.setAttribute('aria-expanded', 'false');
        openBtn?.focus();
      });
      openBtn?.addEventListener('click', openMenu);
      closeBtn?.addEventListener('click', closeMenu);
      backdrop?.addEventListener('click', closeMenu);
      const desktop = window.matchMedia('(min-width: 768px)');
      desktop.addEventListener('change', event => { if (event.matches) closeMenu(); });
    </script>
    <Attribution />
  </body>
</html>
