---
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/interior.css';
import EntitySchema from '../components/EntitySchema.astro';
import Attribution from '../components/Attribution.astro';
import TagManager from '../components/TagManager.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/navigation.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  lang?: 'en' | 'es';
  guideAlternates?: boolean;
}

const { title, description, image = '/images/florida-damaged-house-hero.png', noindex = false, lang = 'en', guideAlternates = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <TagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {guideAlternates && <>
      <link rel="alternate" hreflang="en-US" href="https://allclaimguardians.com/resources/claim-review-guide/" />
      <link rel="alternate" hreflang="es-US" href="https://allclaimguardians.com/es/guia-reclamacion/" />
      <link rel="alternate" hreflang="x-default" href="https://allclaimguardians.com/resources/claim-review-guide/" />
    </>}
    
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <!-- Open Graph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Claim Guardians" />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    
    <EntitySchema />
    <slot name="head" />
  </head>
  <body class="bg-base-bg text-text-main font-sans antialiased min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader />

    <main id="main-content" tabindex="-1" class:list={['flex-grow', { 'interior-page': !['/', '/service-areas/'].includes(Astro.url.pathname) }]}>
      <slot />
    </main>

    <!-- 8. Premium Mega Footer -->
    <SiteFooter />
    <Attribution />
  </body>
</html>
